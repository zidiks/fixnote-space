# Copy to .env on the VPS. None of these are secret: the anon key is the app's public one.

# The address the app calls (an A record pointing at this VPS); Caddy gets the certificate.
VOICE_DOMAIN=voice.fixnote.space
# The same values as the app's VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# Speech model: small (good Russian, about 1.5 s a phrase on 4 cores) or base (about 0.5 s,
# more mistakes). Changing it needs a rebuild: docker compose up -d --build.
WHISPER_MODEL=small
# Recognitions and syntheses at the same time; CPU threads for Whisper (0 = all cores).
VOICE_WORKERS=2
WHISPER_THREADS=0
# How fast the voice speaks (1.0 = as recorded).
TTS_SPEED=1.0
# Per account and minute.
STT_PER_MINUTE=30
TTS_PER_MINUTE=120
