# Cloudflare static assets. Built files carry a content hash, so they never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The app stays out of search results (and so do shared links); fixnote.space is the site to find.
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
