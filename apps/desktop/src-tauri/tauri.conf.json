{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FixNote",
  "version": "0.1.2",
  "identifier": "space.fixnote.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @fixnote/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @fixnote/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "FixNote",
        "width": 1280,
        "height": 820,
        "minWidth": 560,
        "minHeight": 440,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: https:",
        "media-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co https://huggingface.co https://*.huggingface.co https://*.hf.co https://cdn.jsdelivr.net",
        "worker-src": "'self' blob:"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://fixnote.space/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/fixnote-mcp"],
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Private personal notes",
    "longDescription": "Private personal notes with an assistant that helps you remember.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/installer-hooks.nsh",
        "languages": ["English", "Russian", "Spanish"],
        "displayLanguageSelector": true
      },
      "wix": {
        "language": ["en-US", "ru-RU", "es-ES"]
      }
    }
  }
}
