{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FixNote",
  "version": "0.1.0",
  "identifier": "space.fixnote.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @fixnote/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @fixnote/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "FixNote",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: https:",
        "media-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Private personal notes",
    "longDescription": "Private personal notes with an assistant that helps you remember.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian", "Spanish"],
        "displayLanguageSelector": true
      },
      "wix": {
        "language": ["en-US", "ru-RU", "es-ES"]
      }
    }
  }
}
