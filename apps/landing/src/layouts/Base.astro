---
import interCyrillic from '@fontsource-variable/inter/files/inter-cyrillic-wght-normal.woff2?url'
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import { HTML_LANG, LANGS, type Lang, localePath, OG_LOCALE, t } from '../i18n'
import '../styles/global.css'

interface Props {
  lang: Lang
  title: string
  description: string
  /** The page path without its language prefix, e.g. "/features/". */
  path: string
  /** Paths of this page in other languages; by default every language has the same page. */
  alternates?: Partial<Record<Lang, string>>
  image?: string
  type?: 'website' | 'article'
  jsonLd?: Record<string, unknown>[]
  /** Keep the page out of search results (the 404 page). */
  noindex?: boolean
  /** Numbered footnotes printed above the footer links. */
  notes?: readonly string[]
  /** The page's name in the footer breadcrumb (none on the home page). */
  crumb?: string
}
const {
  lang,
  title,
  description,
  path,
  type = 'website',
  jsonLd = [],
  noindex = false,
  notes = [],
  crumb,
} = Astro.props
const site = Astro.site ?? new URL('https://fixnote.space')
const alternates: Partial<Record<Lang, string>> =
  Astro.props.alternates ?? Object.fromEntries(LANGS.map((l) => [l, localePath(l, path)]))
const canonical = new URL(alternates[lang] ?? localePath(lang, path), site).href
const image = new URL(Astro.props.image ?? `/og/${lang}.png`, site).href
const d = t(lang)
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'FixNote',
  url: site.href,
  logo: new URL('/favicon.svg', site).href,
}
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {
      Object.entries(alternates).map(([l, href]) => (
        <link rel="alternate" hreflang={HTML_LANG[l as Lang]} href={new URL(href, site).href} />
      ))
    }
    {alternates.en && <link rel="alternate" hreflang="x-default" href={new URL(alternates.en, site).href} />}
    <link rel="preload" href={lang === 'ru' ? interCyrillic : interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f5f5f7" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="FixNote" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    {!Astro.props.image && <meta property="og:image:width" content="1200" />}
    {!Astro.props.image && <meta property="og:image:height" content="630" />}
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="alternate" type="application/rss+xml" title={d.meta.blog.title} href={localePath(lang, '/rss.xml')} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify([organization, ...jsonLd])} />
  </head>
  <body class="flex min-h-screen flex-col overflow-x-clip">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-white focus:px-4 focus:py-2 focus:shadow"
      >{d.nav.skip}</a
    >
    <Header lang={lang} path={path} alternates={alternates} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} alternates={alternates} notes={notes} crumb={crumb} />
    <script is:inline>
      // Blocks below the first screen fade in as they arrive.
      ;(() => {
        const show = (el) => el.classList.add('in')
        if (!('IntersectionObserver' in window)) {
          document.querySelectorAll('.fx').forEach(show)
          return
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting && e.boundingClientRect.top > 0) continue
              show(e.target)
              io.unobserve(e.target)
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
        )
        document.querySelectorAll('.fx').forEach((el) => io.observe(el))
      })()
      // Galleries: the round arrows scroll by one card and grey out at either end.
      ;(() => {
        for (const g of document.querySelectorAll('[data-gallery]')) {
          const list = g.querySelector('.gallery-track')
          const prev = g.querySelector('[data-prev]')
          const next = g.querySelector('[data-next]')
          if (!list || !prev || !next) continue
          const step = () => (list.firstElementChild?.getBoundingClientRect().width ?? 300) + 20
          const update = () => {
            prev.disabled = list.scrollLeft < 4
            next.disabled = list.scrollLeft + list.clientWidth > list.scrollWidth - 4
          }
          prev.addEventListener('click', () => list.scrollBy({ left: -step(), behavior: 'smooth' }))
          next.addEventListener('click', () => list.scrollBy({ left: step(), behavior: 'smooth' }))
          list.addEventListener('scroll', update, { passive: true })
          window.addEventListener('resize', update)
          update()
        }
      })()
      // Videos play while on screen and stop out of sight; the round button pauses and resumes.
      // With reduced motion they wait for the button.
      ;(() => {
        const still = matchMedia('(prefers-reduced-motion: reduce)').matches
        const videos = document.querySelectorAll('video[data-autoplay]')
        const sync = (v) => {
          const b = v.parentElement?.querySelector('[data-media-control]')
          if (!b) return
          b.toggleAttribute('data-playing', !v.paused)
          b.setAttribute('aria-label', v.paused ? b.dataset.play : b.dataset.pause)
        }
        const play = (v) => v.play().catch(() => {})
        const io =
          'IntersectionObserver' in window
            ? new IntersectionObserver(
                (entries) => {
                  for (const e of entries) {
                    const v = e.target
                    if (e.isIntersecting && !v.dataset.paused && !still) play(v)
                    else if (!e.isIntersecting && !v.paused) v.pause()
                  }
                },
                { threshold: 0.4 },
              )
            : null
        for (const v of videos) {
          v.addEventListener('play', () => sync(v))
          v.addEventListener('pause', () => sync(v))
          v.parentElement?.querySelector('[data-media-control]')?.addEventListener('click', () => {
            if (v.paused) {
              delete v.dataset.paused
              play(v)
            } else {
              v.dataset.paused = '1'
              v.pause()
            }
          })
          if (io) io.observe(v)
        }
      })()
      // The features block: "Show" puts that item's picture in the big frame.
      ;(() => {
        for (const box of document.querySelectorAll('[data-showcase]')) {
          const panes = box.querySelectorAll('[data-pane]')
          const buttons = box.querySelectorAll('[data-show]')
          for (const b of buttons) {
            b.addEventListener('click', () => {
              for (const p of panes) p.toggleAttribute('data-active', p.dataset.pane === b.dataset.show)
              for (const o of buttons) {
                const on = o === b
                o.classList.toggle('btn-neutral', on)
                o.classList.toggle('btn-primary', !on)
                o.textContent = on ? o.dataset.now : o.dataset.label
                o.setAttribute('aria-pressed', String(on))
              }
            })
          }
        }
      })()
    </script>
  </body>
</html>
