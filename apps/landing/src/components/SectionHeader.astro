---
import type { Part } from '../i18n'
import Eyebrow from './Eyebrow.astro'
import Headline from './Headline.astro'

interface Props {
  eyebrow?: string
  parts: Part[]
  lead?: string
  as?: 'h1' | 'h2'
  class?: string
}
const { eyebrow, parts, lead, as = 'h2', class: className } = Astro.props
---

<div class:list={['mx-auto max-w-[860px] text-center', className]}>
  {eyebrow && <div class="reveal"><Eyebrow>{eyebrow}</Eyebrow></div>}
  <Headline
    as={as}
    parts={parts}
    class={`${eyebrow ? 'mt-3 ' : ''}text-[38px] sm:text-[56px] lg:text-[64px]`}
  />
  {lead && <p class="reveal lead mx-auto mt-5 max-w-[640px] text-[17px] sm:text-[21px]" style="--delay:150ms">{lead}</p>}
  <slot />
</div>
