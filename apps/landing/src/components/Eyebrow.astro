---
/** The small coloured line above a headline. */
interface Props {
  tone?: 'brand' | 'ai' | 'muted' | 'light'
  class?: string
  style?: string
}
const { tone = 'brand', class: className, style } = Astro.props
const tones = {
  brand: 'text-brand-deep',
  ai: 'ai-gradient',
  muted: 'text-muted',
  light: 'text-white/70',
}
---

<p style={style} class:list={['text-[15px] font-semibold tracking-[-0.01em] sm:text-[17px]', tones[tone], className]}>
  <slot />
</p>
