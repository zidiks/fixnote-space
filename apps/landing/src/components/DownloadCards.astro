---
import { APP_URL, DOWNLOADS, type Lang, t } from '../i18n'

/** One row per installer plus the web app. The Mac rows share the #mac anchor the hero links to. */
interface Props {
  lang: Lang
}
const d = t(Astro.props.lang).download
const cards = [
  { ...d.windows, href: DOWNLOADS.windows, id: 'windows', external: false },
  { ...d.macArm, href: DOWNLOADS.macArm, id: 'mac', external: false },
  { ...d.macIntel, href: DOWNLOADS.macIntel, id: undefined, external: false },
  { ...d.web, href: APP_URL, id: 'web', external: true },
]
---

<ul class="mt-12 border-t border-line">
  {
    cards.map((card) => (
      <li id={card.id} class="flex scroll-mt-20 flex-wrap items-center justify-between gap-x-6 gap-y-3 border-b border-line py-6">
        <div>
          <h2 class="typo-eyebrow text-ink">{card.name}</h2>
          <p class="typo-caption mt-1 text-muted">{card.detail}</p>
        </div>
        <a href={card.href} class:list={['btn', card.external ? 'btn-secondary' : 'btn-primary']}>
          {card.button}
        </a>
      </li>
    ))
  }
</ul>
