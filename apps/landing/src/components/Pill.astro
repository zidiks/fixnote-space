---
/** A rounded link button: the filled one is the main action, the outlined one sits next to it. */
interface Props {
  href: string
  variant?: 'brand' | 'outline' | 'dark' | 'light' | 'ghost'
  size?: 'sm' | 'base' | 'md'
  class?: string
  id?: string
  [key: `data-${string}`]: string | undefined
}
const { href, variant = 'brand', size = 'md', class: className, id, ...data } = Astro.props
const variants = {
  brand: 'bg-brand text-white hover:bg-brand-deep',
  outline: 'text-link ring-1 ring-inset ring-brand hover:bg-brand hover:text-white',
  dark: 'bg-ink text-white hover:bg-[#3a3a3c]',
  light: 'bg-white text-ink hover:bg-white/85',
  ghost: 'text-white ring-1 ring-inset ring-white/40 hover:bg-white/10',
}
const sizes = {
  sm: 'h-7 px-3.5 text-[13px]',
  base: 'h-9 px-4 text-[15px]',
  md: 'h-11 px-5 text-[17px]',
}
---

<a
  href={href}
  id={id}
  {...data}
  class:list={[
    'inline-flex items-center justify-center gap-1.5 whitespace-nowrap rounded-full font-medium tracking-[-0.01em] transition active:scale-[0.98]',
    sizes[size],
    variants[variant],
    className,
  ]}
>
  <slot />
</a>
