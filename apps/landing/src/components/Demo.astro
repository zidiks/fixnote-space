---
import { Picture } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { type Lang, t } from '../i18n'

/**
 * The app in a frame of a fixed ratio, cut from the top left and rounded like a window. A short
 * video when one was recorded (public/video/<lang>/<name>.mp4 with a .jpg poster; it plays while
 * on screen, see Base.astro), otherwise a screenshot from src/assets/shots/<lang>/<name>.png.
 */
interface Props {
  lang: Lang
  name: string
  alt: string
  /** Width / height of the frame; the shot's own ratio by default. */
  ratio?: number
  /** CSS `sizes` of the picture. */
  sizes?: string
  eager?: boolean
  /** No rounding or outline (a shot that fills a card edge to edge). */
  flat?: boolean
  /** Show the screenshot even when a video exists. */
  still?: boolean
  class?: string
}
/** Names recorded as video in every language, from the web app with ?dev-backend (CDP screencast, ffmpeg). */
const VIDEOS = new Set(['home', 'ai-dark', 'daily', 'search', 'tidy', 'folder', 'voice'])
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/shots/*/*.png', {
  eager: true,
})
const {
  lang,
  name,
  alt,
  sizes = '(min-width: 1069px) 940px, 90vw',
  eager = false,
  flat = false,
  still = false,
} = Astro.props
const shot = shots[`../assets/shots/${lang}/${name}.png`]?.default
if (!shot) throw new Error(`No screenshot ${lang}/${name}`)
const ratio = Astro.props.ratio ?? shot.width / shot.height
const video = !still && VIDEOS.has(name)
const m = t(lang).media
---

<div class:list={['demo', flat && 'demo-flat', Astro.props.class]} style={`aspect-ratio:${ratio}`}>
  {
    video ? (
      <>
        <video
          src={`/video/${lang}/${name}.mp4`}
          poster={`/video/${lang}/${name}.jpg`}
          aria-label={alt}
          muted
          playsinline
          loop
          preload="none"
          data-autoplay
        />
        <button type="button" class="media-control" data-media-control data-play={m.play} data-pause={m.pause} aria-label={m.play}>
          <svg class="media-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.5v9l7.5-4.5z" fill="currentColor" /></svg>
          <svg class="media-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 3h2.5v10H4.5zM9 3h2.5v10H9z" fill="currentColor" /></svg>
        </button>
      </>
    ) : (
      <Picture
        src={shot}
        alt={alt}
        formats={['avif', 'webp']}
        widths={[480, 800, 1200, 1600, 2200]}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        decoding="async"
      />
    )
  }
</div>
