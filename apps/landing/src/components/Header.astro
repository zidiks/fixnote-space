---
import Download from '@lucide/astro/icons/download'
import { type Lang, localePath, t } from '../i18n'
import LangMenu from './LangMenu.astro'

/**
 * Two bars, like a product page: the site's global nav (the icon, every page, the download icon)
 * that scrolls away, and the product bar under it (the name, the sections of the home page, the
 * download button) that sticks to the top. On phones the global nav opens a full-screen menu.
 */
interface Props {
  lang: Lang
  path: string
  alternates: Partial<Record<Lang, string>>
}
const { lang, path, alternates } = Astro.props
const d = t(lang)
const home = localePath(lang, '/')
const pages = [
  { label: d.nav.features, href: '/features/' },
  { label: d.nav.security, href: '/security/' },
  { label: d.nav.pricing, href: '/#pricing' },
  { label: d.nav.download, href: '/download/' },
  { label: d.nav.blog, href: '/blog/' },
  { label: d.nav.faq, href: '/#faq' },
]
const sections = [
  { label: d.nav.overview, href: '#overview' },
  { label: d.nav.features, href: '#features' },
  { label: d.nav.tools, href: '#tools' },
  { label: d.nav.compare, href: '#compare' },
  { label: d.nav.pricing, href: '#pricing' },
  { label: d.nav.faq, href: '#faq' },
]
const onHome = path === '/'
const active = (href: string) => path === href || (href === '/blog/' && path.startsWith('/blog/'))
---

<div class="relative z-[60]">
  <input type="checkbox" id="gnav-toggle" class="gnav-toggle sr-only" aria-hidden="true" tabindex="-1" />
  <div class="absolute inset-0 bg-[rgb(250_250_252/0.8)] backdrop-blur-[20px] backdrop-saturate-[1.8]"></div>
  <nav
    aria-label="Global"
    class="relative mx-auto flex h-12 max-w-[1024px] items-center justify-between px-4 nav:h-11 nav:px-[22px]"
  >
    <a href={home} aria-label="FixNote" class="flex h-full items-center px-2 opacity-90 transition-opacity hover:opacity-100">
      <img src="/favicon.svg" alt="" width="20" height="20" class="h-5 w-5" />
    </a>
    <ul class="hidden flex-1 items-center justify-between px-6 nav:flex">
      {
        pages.map((item) => (
          <li>
            <a
              href={localePath(lang, item.href)}
              aria-current={active(item.href) ? 'page' : undefined}
              class="block px-2 text-[12px] leading-[44px] tracking-[-0.01em] text-black/80 transition-colors hover:text-black"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="flex items-center">
      <LangMenu lang={lang} alternates={alternates} />
      <a
        href={localePath(lang, '/download/')}
        aria-label={d.nav.download}
        class="flex h-11 items-center px-2 text-black/80 transition-colors hover:text-black"
      >
        <Download size={16} stroke-width={1.6} />
      </a>
      <label
        for="gnav-toggle"
        class="flex h-12 cursor-pointer items-center px-2 text-black/80 nav:hidden"
        aria-label={d.nav.menu}
      >
        <svg class="gnav-open" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
          <path d="M2 6h14M2 12h14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
        </svg>
        <svg class="gnav-close" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
          <path d="M4 4l10 10M14 4L4 14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
        </svg>
      </label>
    </div>
  </nav>
  <div class="gnav-menu fixed inset-x-0 top-12 bottom-0 hidden overflow-y-auto bg-[#fafafc] px-12 pt-6 pb-16 nav:hidden">
    <ul class="space-y-3">
      <li><a href={home} class="typo-subhead block text-[#333336]">{d.nav.overview}</a></li>
      {
        pages.map((item) => (
          <li>
            <a href={localePath(lang, item.href)} class="typo-subhead block text-[#333336]">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>
<div class="sticky top-0 z-50">
  <div class="absolute inset-0 bg-panel"></div>
  <nav aria-label="FixNote" class="relative mx-auto flex h-[52px] max-w-[1024px] items-center px-4 nav:px-[22px]">
    <a href={home} class="font-display text-[21px] leading-none font-semibold tracking-[0.011em] text-ink">FixNote</a>
    <ul class="ml-auto hidden items-center gap-6 nav:flex">
      {
        sections.map((item) => (
          <li>
            <a
              href={onHome ? item.href : `${home}${item.href}`}
              class="text-[12px] tracking-[-0.01em] text-black/80 transition-colors hover:text-link"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href={localePath(lang, '/download/')}
      id="lnav-download"
      class="btn btn-primary btn-sm ml-auto nav:ml-6"
    >
      {d.nav.download}
    </a>
  </nav>
  <div class="pointer-events-none absolute bottom-0 left-1/2 h-px w-[min(980px,calc(100%-32px))] -translate-x-1/2 bg-black/[0.16]"></div>
</div>
