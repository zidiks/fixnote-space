---
import { type Lang, localePath, t } from '../i18n'
import { featurePath } from '../lib/pages'
import LangMenu from './LangMenu.astro'
import LogoMark from './LogoMark.astro'

/**
 * One bar: the mark (it is the way home) and product links on the left, an empty centre, the rest and Download on the right.
 * It lies flat over the top of the page and, once the page scrolls, gathers into a floating pill
 * (`data-float`, set by the observer below; no scroll handler). Phones get a full-screen menu
 * (a checkbox, no script). Pages that draw under it (`overlay`) get no spacer.
 */
interface Props {
  lang: Lang
  path: string
  alternates: Partial<Record<Lang, string>>
  overlay?: boolean
}
const { lang, path, alternates, overlay = false } = Astro.props
const d = t(lang)
const home = { label: d.nav.home, href: localePath(lang, '/'), page: '/' }
const left = [
  { label: d.nav.features, href: localePath(lang, '/features/'), page: '/features/' },
  { label: d.nav.tidy, href: featurePath(lang, 'tidy-up') },
  { label: d.nav.integrations, href: featurePath(lang, 'mcp') },
  { label: d.nav.search, href: featurePath(lang, 'search') },
  { label: d.nav.privacy, href: localePath(lang, '/security/'), page: '/security/' },
]
const right = [
  { label: d.nav.pricing, href: localePath(lang, '/#pricing') },
  { label: d.nav.faq, href: localePath(lang, '/#faq') },
  { label: d.nav.help, href: localePath(lang, '/setup/'), page: '/setup/' },
  { label: d.nav.blog, href: localePath(lang, '/blog/'), page: '/blog/' },
]
const current = (page?: string) =>
  page !== undefined && (path === page || (page === '/blog/' && path.startsWith('/blog/')))
---

<div id="hdr-sentinel" class="pointer-events-none absolute top-0 left-0 h-6 w-px" aria-hidden="true"></div>
<header class="hdr">
  <input type="checkbox" id="gnav-toggle" class="gnav-toggle sr-only" aria-hidden="true" tabindex="-1" />
  <nav aria-label="Global" class="hdr-bar">
    <div class="flex items-center">
      <label for="gnav-toggle" class="hdr-menu medium:hidden">
        <span class="sr-only">{d.nav.menu}</span>
        <svg class="gnav-open" width="20" height="20" viewBox="0 0 18 18" aria-hidden="true">
          <path d="M2 6h14M2 12h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
        </svg>
        <svg class="gnav-close" width="20" height="20" viewBox="0 0 18 18" aria-hidden="true">
          <path d="M4 4l10 10M14 4L4 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
        </svg>
      </label>
      <ul class="hdr-links hidden medium:flex">
        <li>
          <a href={home.href} aria-current={current(home.page) ? 'page' : undefined} aria-label={home.label} class="hdr-link hdr-brand">
            <LogoMark />
          </a>
        </li>
        {
          left.map((item) => (
            <li>
              <a href={item.href} aria-current={current(item.page) ? 'page' : undefined} class="hdr-link">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="hdr-logo" aria-hidden="true"></div>
    <div class="flex items-center justify-end">
      <ul class="hdr-links hdr-links-quiet hidden wide:flex">
        {
          right.map((item) => (
            <li>
              <a href={item.href} aria-current={current(item.page) ? 'page' : undefined} class="hdr-link">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href={localePath(lang, '/download/')} class="btn-pill btn-pill-orange hdr-download">{d.nav.download}</a>
      <div class="hdr-lang hidden nav:block">
        <LangMenu lang={lang} alternates={alternates} large />
      </div>
    </div>
  </nav>
  <div class="gnav-menu pointer-events-auto fixed inset-x-0 top-0 bottom-0 hidden overflow-y-auto bg-canvas px-8 pt-24 pb-16 medium:hidden">
    <ul class="space-y-3">
      {
        [home, ...left, ...right].map((item) => (
          <li>
            <a href={item.href} class="block text-[28px] leading-tight font-medium tracking-[-0.03em] text-ink">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-8">
      <LangMenu lang={lang} alternates={alternates} footer />
    </div>
  </div>
</header>
{!overlay && <div class="hdr-space" aria-hidden="true"></div>}

<script is:inline>
  // The bar floats once the top of the page is out of sight.
  ;(() => {
    const top = document.getElementById('hdr-sentinel')
    const bar = document.querySelector('.hdr')
    if (!top || !bar || !('IntersectionObserver' in window)) return
    new IntersectionObserver(([e]) => bar.toggleAttribute('data-float', !e.isIntersecting)).observe(top)
  })()
</script>
