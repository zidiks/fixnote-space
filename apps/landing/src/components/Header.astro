---
import Menu from '@lucide/astro/icons/menu'
import { type Lang, localePath, t } from '../i18n'
import Brand from './Brand.astro'
import LangMenu from './LangMenu.astro'
import Pill from './Pill.astro'

/** A thin sticky bar: the name on the left, sections and the download button on the right. */
interface Props {
  lang: Lang
  path: string
  alternates: Partial<Record<Lang, string>>
}
const { lang, path, alternates } = Astro.props
const d = t(lang)
const nav = [
  { label: d.nav.features, href: '/features/' },
  { label: d.nav.security, href: '/security/' },
  { label: d.nav.pricing, href: '/#pricing' },
  { label: d.nav.blog, href: '/blog/' },
]
const active = (href: string) => path === href || (href === '/blog/' && path.startsWith('/blog/'))
---

<header class="sticky top-0 z-50 border-b border-black/[0.08] bg-[#f5f5f7]/80 backdrop-blur-xl backdrop-saturate-150">
  <div class="mx-auto flex h-[52px] max-w-[1040px] items-center justify-between gap-3 px-4 sm:px-6">
    <a href={localePath(lang, '/')} aria-label="FixNote"><Brand /></a>
    <div class="flex items-center gap-1 sm:gap-2">
      <nav class="mr-2 hidden items-center gap-6 md:flex" aria-label="FixNote">
        {
          nav.map((item) => (
            <a
              href={localePath(lang, item.href)}
              aria-current={active(item.href) ? 'page' : undefined}
              class:list={[
                'text-[13px] tracking-[-0.005em] transition hover:text-ink',
                active(item.href) ? 'text-ink' : 'text-ink/70',
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <div class="hidden sm:block"><LangMenu lang={lang} alternates={alternates} /></div>
      <details class="group relative md:hidden">
        <summary
          class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-full text-ink/70 [&::-webkit-details-marker]:hidden"
          aria-label="Menu"
        >
          <Menu size={19} />
        </summary>
        <div class="absolute right-0 top-11 w-56 rounded-2xl bg-white p-2 shadow-[0_12px_32px_rgba(0,0,0,0.12)] ring-1 ring-black/5">
          {
            nav.map((item) => (
              <a href={localePath(lang, item.href)} class="block rounded-xl px-3 py-2.5 text-[15px] hover:bg-canvas">
                {item.label}
              </a>
            ))
          }
          <div class="mt-1 border-t border-line pt-1 sm:hidden"><LangMenu lang={lang} alternates={alternates} /></div>
        </div>
      </details>
      <Pill href={localePath(lang, '/download/')} size="sm">{d.nav.download}</Pill>
    </div>
  </div>
</header>
