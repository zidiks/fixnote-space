---
import { Picture } from 'astro:assets'
import en from '../assets/shots/home-en.png'
import es from '../assets/shots/home-es.png'
import ru from '../assets/shots/home-ru.png'
import type { Lang } from '../i18n'

/**
 * The app screenshot on a soft backdrop. It is the largest thing on the first screen, so it loads
 * eagerly with high priority, in AVIF/WebP, at the width the layout needs.
 */
interface Props {
  lang: Lang
  alt: string
}
const { lang, alt } = Astro.props
const shots = { ru, en, es }
---

<div class="backdrop overflow-hidden rounded-[20px] p-3 sm:rounded-[28px] sm:p-8 lg:p-10">
  <Picture
    src={shots[lang]}
    alt={alt}
    formats={['avif', 'webp']}
    widths={[640, 960, 1280, 1600, 2200]}
    sizes="(min-width: 1100px) 940px, 90vw"
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="block h-auto w-full rounded-[10px] shadow-[0_30px_80px_-24px_rgba(60,30,10,0.45),0_0_0_1px_rgba(0,0,0,0.06)] sm:rounded-[14px]"
  />
</div>
