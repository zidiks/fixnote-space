---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import type { AppId } from '../data/apps'

/**
 * An app's icon: FixNote's own, or the other app's App Store icon (src/assets/apps/<id>.png, 256 px
 * squares) in the same rounded square. A hairline keeps white icons visible on white.
 */
interface Props {
  app: AppId
  size?: number
  class?: string
}
const { app, size = 48, class: className } = Astro.props
const icons = import.meta.glob<{ default: ImageMetadata }>('../assets/apps/*.png', { eager: true })
// FixNote has no file here and uses the site's favicon.
const icon = icons[`../assets/apps/${app}.png`]?.default
const radius = Math.round(size * 0.223)
---

{
  !icon ? (
    <img src="/favicon.svg" alt="" width={size} height={size} class={className} style={`width:${size}px;height:${size}px`} />
  ) : (
    <span
      class:list={['relative block shrink-0 overflow-hidden', className]}
      style={`width:${size}px;height:${size}px;border-radius:${radius}px`}
    >
      <Image src={icon} alt="" width={size * 2} height={size * 2} class="h-full w-full" />
      <span class="pointer-events-none absolute inset-0 shadow-[inset_0_0_0_1px_rgb(0_0_0/0.1)]" style={`border-radius:${radius}px`} />
    </span>
  )
}
