---
import Plus from '@lucide/astro/icons/plus'

/** Native <details>: works without JavaScript, and the answers stay in the HTML for search engines. */
interface Props {
  items: readonly { q: string; a: string }[]
}
---

<div class="mx-auto max-w-[820px] border-t border-line">
  {
    Astro.props.items.map((item) => (
      <details class="faq-item border-b border-line">
        <summary class="flex items-center justify-between gap-4 py-5 text-[17px] font-semibold tracking-[-0.015em] sm:text-[19px]">
          {item.q}
          <span class="faq-icon flex size-7 shrink-0 items-center justify-center text-ink transition">
            <Plus size={20} />
          </span>
        </summary>
        <p class="max-w-[700px] pb-6 text-[16px] leading-[1.6] text-muted sm:text-[17px]">{item.a}</p>
      </details>
    ))
  }
</div>
