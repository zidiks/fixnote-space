---
import Plus from '@lucide/astro/icons/plus'

/** Native <details>: works without JavaScript, and the answers stay in the HTML for search engines. */
interface Props {
  items: readonly { q: string; a: string }[]
}
---

<div class="mx-auto max-w-[820px] space-y-3">
  {
    Astro.props.items.map((item, i) => (
      <details class="faq-item reveal rounded-[22px] bg-white shadow-[0_1px_2px_rgba(27,26,24,0.05)] ring-1 ring-black/[0.04]" style={`--delay:${i * 50}ms`}>
        <summary class="flex items-center justify-between gap-4 px-6 py-5 text-[17px] font-semibold tracking-[-0.02em] sm:text-lg">
          {item.q}
          <span class="faq-icon flex size-8 shrink-0 items-center justify-center rounded-full bg-canvas transition">
            <Plus size={16} />
          </span>
        </summary>
        <p class="px-6 pb-6 text-[15px] leading-[1.65] text-muted sm:text-base">{item.a}</p>
      </details>
    ))
  }
</div>
