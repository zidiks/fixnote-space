---
import ChevronLeft from '@lucide/astro/icons/chevron-left'
import ChevronRight from '@lucide/astro/icons/chevron-right'

/**
 * A row of cards that scrolls sideways (scroll-snap), with arrows under it. The arrows are wired by
 * the small script in Base.astro; without JavaScript the row still scrolls by touch or trackpad.
 */
interface Props {
  prev: string
  next: string
}
const { prev, next } = Astro.props
---

<div data-scroller class="reveal">
  <ul class="scroller flex gap-4 overflow-x-auto pb-2">
    <slot />
  </ul>
  <div class="mt-6 flex justify-center gap-3">
    <button
      type="button"
      data-prev
      aria-label={prev}
      class="scroll-arrow flex size-9 items-center justify-center rounded-full bg-[#e8e8ed] text-ink/80 transition hover:bg-[#dcdce1]"
    >
      <ChevronLeft size={19} />
    </button>
    <button
      type="button"
      data-next
      aria-label={next}
      class="scroll-arrow flex size-9 items-center justify-center rounded-full bg-[#e8e8ed] text-ink/80 transition hover:bg-[#dcdce1]"
    >
      <ChevronRight size={19} />
    </button>
  </div>
</div>
