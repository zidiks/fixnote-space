---
/** An orange link with the round arrow of the design; the arrow leans out on hover (home.css). */
interface Props {
  href: string
  /** 16px text and a 20px arrow, or 18px and 24px. */
  size?: 'md' | 'lg'
  class?: string
}
const { href, size = 'md', class: className } = Astro.props
---

<a href={href} class:list={['arrow-link', size === 'lg' && 'arrow-link-lg', className]}>
  <span><slot /></span>
  <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
    <path
      class="arrow-head"
      d="M10.83 9.17 18.33 1.67M18.33 6.12V1.67h-4.45"
      stroke="currentColor"
      stroke-width="1.25"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
    <path
      d="M10 1.67a8.33 8.33 0 1 0 8.33 8.33"
      stroke="currentColor"
      stroke-opacity="0.4"
      stroke-width="1.25"
      stroke-linecap="round"></path>
  </svg>
</a>
