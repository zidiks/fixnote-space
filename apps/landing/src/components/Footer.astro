---
import ChevronRight from '@lucide/astro/icons/chevron-right'
import { APP_URL, type Lang, localePath, PRIVACY_EMAIL, t } from '../i18n'
import LangMenu from './LangMenu.astro'

/** Small grey print: the page's footnotes (if it has any), link columns, the language switcher. */
interface Props {
  lang: Lang
  alternates: Partial<Record<Lang, string>>
  notes?: readonly string[]
}
const { lang, alternates, notes = [] } = Astro.props
const d = t(lang)
const columns = [
  {
    title: d.footer.product,
    links: [
      { label: d.nav.features, href: localePath(lang, '/features/') },
      { label: d.nav.security, href: localePath(lang, '/security/') },
      { label: d.nav.pricing, href: localePath(lang, '/#pricing') },
      { label: d.nav.download, href: localePath(lang, '/download/') },
      { label: d.footer.webApp, href: APP_URL },
    ],
  },
  {
    title: d.footer.resources,
    links: [
      { label: d.nav.blog, href: localePath(lang, '/blog/') },
      { label: d.footer.rss, href: localePath(lang, '/rss.xml') },
      { label: d.nav.faq, href: localePath(lang, '/#faq') },
    ],
  },
  {
    title: d.footer.company,
    links: [
      { label: d.footer.privacy, href: localePath(lang, '/privacy/') },
      { label: PRIVACY_EMAIL, href: `mailto:${PRIVACY_EMAIL}` },
    ],
  },
]
---

<footer class="bg-canvas px-4 pb-10 pt-4 text-[12px] leading-[1.5] text-muted sm:px-6">
  <div class="mx-auto max-w-[1040px]">
    {
      notes.length > 0 && (
        <ol class="space-y-2 border-b border-line pb-4 pt-4">
          {notes.map((note, i) => (
            <li id={`note-${i + 1}`}>
              {i + 1}. {note}
            </li>
          ))}
        </ol>
      )
    }
    <div class="flex items-center gap-1.5 border-b border-line py-3 text-ink/80">
      <a href={localePath(lang, '/')} aria-label="FixNote"><img src="/favicon.svg" alt="" width="16" height="16" class="size-4" /></a>
      <ChevronRight size={13} class="text-faint" />
      <span>FixNote</span>
    </div>
    <div class="grid gap-8 py-6 sm:grid-cols-3">
      {
        columns.map((column) => (
          <div>
            <div class="font-semibold text-ink/90">{column.title}</div>
            <ul class="mt-2.5 space-y-2">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} class="transition hover:text-ink hover:underline">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-line pt-4">
      <span>© {new Date().getFullYear()} {d.footer.rights}. {d.footer.tagline}</span>
      <LangMenu lang={lang} alternates={alternates} up />
    </div>
  </div>
</footer>
