---
import { APP_URL, CONTACT_EMAIL, type Lang, localePath, t } from '../i18n'
import { getPosts, postPath } from '../lib/blog'
import Chevron from './Chevron.astro'
import LangMenu from './LangMenu.astro'

/**
 * Small grey print: the page's footnotes, a breadcrumb, the directory of the site, help and the
 * copyright line with the language switcher.
 */
interface Props {
  lang: Lang
  alternates: Partial<Record<Lang, string>>
  notes?: readonly string[]
  /** The breadcrumb after "FixNote" (the page's name). */
  crumb?: string
}
const { lang, alternates, notes = [], crumb } = Astro.props
const d = t(lang)
const f = d.footer
const home = localePath(lang, '/')
const posts = (await getPosts(lang)).slice(0, 4)
const columns = [
  {
    title: f.explore,
    links: [
      { label: d.nav.overview, href: home },
      { label: d.nav.features, href: `${home}#features` },
      { label: d.nav.tools, href: `${home}#tools` },
      { label: d.nav.compare, href: `${home}#compare` },
      { label: d.nav.pricing, href: `${home}#pricing` },
      { label: d.nav.faq, href: `${home}#faq` },
    ],
  },
  {
    title: f.product,
    links: [
      { label: d.nav.features, href: localePath(lang, '/features/') },
      { label: d.nav.security, href: localePath(lang, '/security/') },
      { label: f.webApp, href: APP_URL },
    ],
  },
  {
    title: f.download,
    links: [
      { label: d.download.windows.name, href: localePath(lang, '/download/') },
      { label: d.download.macArm.name, href: localePath(lang, '/download/#mac') },
      { label: d.download.macIntel.name, href: localePath(lang, '/download/#mac') },
      { label: d.download.web.name, href: APP_URL },
    ],
  },
  {
    title: d.nav.blog,
    links: [
      ...posts.map((post) => ({ label: post.data.title, href: postPath(post) })),
      { label: f.allPosts, href: localePath(lang, '/blog/') },
    ],
  },
  {
    title: f.support,
    links: [
      { label: f.privacy, href: localePath(lang, '/privacy/') },
      { label: f.rss, href: localePath(lang, '/rss.xml') },
      { label: f.email, href: `mailto:${CONTACT_EMAIL}` },
    ],
  },
]
const linkClass = 'text-black/[0.72] underline-offset-2 hover:text-black hover:underline'
---

<footer class="typo-footnote bg-panel text-black/[0.56]">
  <div class="content">
    {
      notes.length > 0 && (
        <section aria-label={f.notes} class="border-b border-black/[0.16] pt-[17px] pb-[11px]">
          <ol class="list-none space-y-[0.8em]">
            {notes.map((note, i) => (
              <li id={`footnote-${i + 1}`}>
                <span class="mr-1">{i + 1}.</span>
                {note}
              </li>
            ))}
          </ol>
        </section>
      )
    }
    <nav aria-label={f.breadcrumbs} class="flex items-center gap-2.5 border-b border-black/[0.16] py-3.5">
      <a href={home} aria-label="FixNote" class="shrink-0">
        <img src="/favicon.svg" alt="" width="16" height="16" class="h-4 w-4" />
      </a>
      <Chevron class="h-[9px] w-[6px] text-black/[0.56]" />
      {
        crumb ? (
          <>
            <a href={home} class={linkClass}>
              FixNote
            </a>
            <Chevron class="h-[9px] w-[6px] text-black/[0.56]" />
            <span class="text-black/[0.88]">{crumb}</span>
          </>
        ) : (
          <span class="text-black/[0.88]">FixNote</span>
        )
      }
    </nav>
    <nav
      aria-label={f.directory}
      class="grid grid-cols-2 gap-x-5 gap-y-7 pt-5 pb-6 small:grid-cols-3 medium:grid-cols-5"
    >
      {
        columns.map((column) => (
          <div>
            <h3 class="mb-[0.8em] font-semibold text-black/[0.88]">{column.title}</h3>
            <ul class="space-y-[0.8em]">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} class={linkClass}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
    <p class="pb-3">
      {f.help}
      <a href={`mailto:${CONTACT_EMAIL}`} class="text-link hover:underline">{CONTACT_EMAIL}</a>.
    </p>
    <div
      class="flex flex-col gap-2 border-t border-black/[0.16] pt-2 pb-5 small:flex-row small:items-center small:justify-between"
    >
      <div class="flex flex-col gap-1 small:flex-row small:items-center small:gap-7">
        <p>Copyright © {new Date().getFullYear()} FixNote. {f.rights}</p>
        <ul class="flex flex-wrap items-center">
          <li class="leading-none">
            <a class={linkClass} href={localePath(lang, '/privacy/')}>{f.privacy}</a>
          </li>
          <li class="ml-[0.6em] border-l border-black/[0.48] pl-[0.6em] leading-none">
            <a class={linkClass} href={localePath(lang, '/security/')}>{d.nav.security}</a>
          </li>
          <li class="ml-[0.6em] border-l border-black/[0.48] pl-[0.6em] leading-none">
            <a class={linkClass} href={localePath(lang, '/download/')}>{d.nav.download}</a>
          </li>
        </ul>
      </div>
      <LangMenu lang={lang} alternates={alternates} up footer />
    </div>
  </div>
</footer>
