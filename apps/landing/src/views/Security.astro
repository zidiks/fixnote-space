---
import Article from '../components/Article.astro'
import TryCard from '../components/TryCard.astro'
import { type Lang, t } from '../i18n'
import Base from '../layouts/Base.astro'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const d = t(lang)
const p = d.securityPage
/** An illustrative row as the server keeps it: only ciphertext and sync bookkeeping. */
const row = `{
  "id": "5f0c1e9a-7b2d-4c61-9d3e-2a8f41c7b0d5",
  "folder_id": "c2a7d0b4-1e93-4f58-8b6d-03f9e1a45c27",
  "type": "text",
  "daily_date": null,
  "wrapped_key": "Hn4pQ0sVt8LwYc2Ea9Rk1Uf5Jm7Zb3Xg6Do+iNlKe…",
  "ciphertext": "AQx9Fq2VbK0mRr7Zt+aLwE3uJc8yHnD5sPoQ1iGv4TkXe6MzNb/UhCj0WfYlSg2Ad7Rp9KqBnVt3LxEo5Iu8Hc…",
  "created_at": 1790343727000,
  "updated_at": 1790354527000,
  "deleted_at": null,
  "version": 14
}`
---

<Base lang={lang} title={d.meta.security.title} description={d.meta.security.description} path="/security/" crumb={d.nav.security}>
  <Article lang={lang} eyebrow={p.eyebrow} title={p.headline} intro={p.lead}>
    {
      p.sections.map((s) => (
        <section class="mt-14">
          <h2 class="typo-subhead text-ink">{s.title}</h2>
          <p class="typo-body mt-4 text-ink">{s.text}</p>
        </section>
      ))
    }
    <section class="mt-14 rounded-[18px] bg-[#1d1d1f] p-7 text-[#f5f5f7] small:p-10">
      <h2 class="typo-card-headline">{p.stored}</h2>
      <pre class="mt-6 overflow-x-auto font-mono text-[13px] leading-[1.7] whitespace-pre-wrap break-all text-[#a1a1a6]">{row}</pre>
    </section>
    <TryCard lang={lang} />
  </Article>
</Base>
