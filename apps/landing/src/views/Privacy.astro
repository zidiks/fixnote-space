---
import Article from '../components/Article.astro'
import { type Lang, PRIVACY_EMAIL, t } from '../i18n'
import Base from '../layouts/Base.astro'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const d = t(lang)
const p = d.privacyPage
---

<Base lang={lang} title={d.meta.privacy.title} description={d.meta.privacy.description} path="/privacy/" crumb={d.footer.privacy}>
  <Article lang={lang} eyebrow={p.eyebrow} title={p.title} intro={p.lead} cta={false}>
    <p slot="meta" class="typo-caption mt-4 text-muted">{p.updated}</p>
    {
      p.sections.map((s) => (
        <section class="mt-14">
          <h2 class="typo-subhead text-ink">{s.title}</h2>
          {s.text.map((para) => (
            <p class="typo-body mt-4 text-ink">{para}</p>
          ))}
        </section>
      ))
    }
    <section class="mt-14 rounded-[18px] bg-panel p-7 small:p-10">
      <p class="typo-body text-ink">
        {p.contact} <a href={`mailto:${PRIVACY_EMAIL}`} class="link">{PRIVACY_EMAIL}</a>
      </p>
    </section>
  </Article>
</Base>
