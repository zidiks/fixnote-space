---
import SectionHeader from '../components/SectionHeader.astro'
import { type Lang, PRIVACY_EMAIL, t } from '../i18n'
import Base from '../layouts/Base.astro'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const d = t(lang)
const p = d.privacyPage
---

<Base lang={lang} title={d.meta.privacy.title} description={d.meta.privacy.description} path="/privacy/">
  <section class="px-4 pb-6 pt-36 sm:px-6 sm:pt-44">
    <SectionHeader as="h1" eyebrow={p.eyebrow} parts={[p.title]} lead={p.lead} />
    <p class="mt-5 text-center text-sm text-muted">{p.updated}</p>
  </section>
  <section class="px-4 pb-20 pt-6 sm:px-6">
    <div class="mx-auto max-w-[760px] rounded-[24px] bg-white p-7 shadow-[0_1px_2px_rgba(27,26,24,0.05)] ring-1 ring-black/[0.04] sm:p-10">
      {
        p.sections.map((s, i) => (
          <section class:list={[i > 0 && 'mt-9']}>
            <h2 class="text-[20px] font-semibold leading-tight tracking-[-0.02em]">{s.title}</h2>
            {s.text.map((para) => (
              <p class="mt-3 text-[16px] leading-[1.65] text-muted">{para}</p>
            ))}
          </section>
        ))
      }
      <p class="mt-10 border-t border-black/[0.06] pt-6 text-[16px] leading-[1.65]">
        {p.contact}{' '}
        <a href={`mailto:${PRIVACY_EMAIL}`} class="font-medium text-brand hover:underline">{PRIVACY_EMAIL}</a>
      </p>
    </div>
  </section>
</Base>
