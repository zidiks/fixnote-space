---
import Faq from '../../components/Faq.astro'
import SectionHeader from '../../components/SectionHeader.astro'
import { type Lang, t } from '../../i18n'

interface Props {
  lang: Lang
}
const d = t(Astro.props.lang).faq
---

<section id="faq" class="px-4 py-24 sm:px-6 sm:py-32">
  <SectionHeader eyebrow={d.eyebrow} parts={d.headline} />
  <div class="mt-14"><Faq items={d.items} /></div>
</section>
