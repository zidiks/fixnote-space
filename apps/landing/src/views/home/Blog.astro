---
import Gallery from '../../components/Gallery.astro'
import More from '../../components/More.astro'
import { type Lang, localePath, t } from '../../i18n'
import { formatDate, getPosts, postPath, readingMinutes } from '../../lib/blog'

/** The latest articles as cards: the title, what it is about, and the date and reading time at the bottom. */
interface Props {
  lang: Lang
}
const { lang } = Astro.props
const d = t(lang)
const b = d.blogTeaser
const posts = (await getPosts(lang)).slice(0, 9)
---

{
  posts.length > 0 && (
    <section id="blog" class="bg-panel pb-[100px] max-[1068px]:pb-20 max-[734px]:pb-16">
      <header class="section-header">
        <h2 class="typo-section-headline">{b.headline}</h2>
        <More href={localePath(lang, '/blog/')} class="typo-intro mt-4 inline-block">
          {b.all}
        </More>
      </header>
      <Gallery label={b.label} prev={d.reasons.prev} next={d.reasons.next}>
        {posts.map((post) => (
          <li class="gallery-item">
            <a
              href={postPath(post)}
              class="group flex h-[320px] flex-col rounded-[18px] bg-white p-8 text-left transition-shadow duration-300 hover:shadow-[0_12px_32px_-12px_rgb(0_0_0/0.18)] max-[734px]:h-[300px] max-[734px]:p-6"
            >
              <p class="typo-card-headline line-clamp-4 text-ink">{post.data.title}</p>
              <p class="typo-body mt-3 line-clamp-3 text-muted">{post.data.description}</p>
              <p class="typo-caption mt-auto pt-6 text-muted">
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time> ·{' '}
                {readingMinutes(post)} {b.minutes}
              </p>
            </a>
          </li>
        ))}
      </Gallery>
    </section>
  )
}
