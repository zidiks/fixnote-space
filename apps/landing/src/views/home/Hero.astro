---
import Download from '@lucide/astro/icons/download'
import Eyebrow from '../../components/Eyebrow.astro'
import MoreLink from '../../components/MoreLink.astro'
import Pill from '../../components/Pill.astro'
import Shot from '../../components/Shot.astro'
import Sup from '../../components/Sup.astro'
import { DOWNLOADS, type Lang, localePath, t } from '../../i18n'
import { topicHref } from '../../lib/blog'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const d = t(lang)
const h = d.hero
const downloadPage = localePath(lang, '/download/')
const callsHref = await topicHref(lang, 'call-notes', '/features/')
---

<div class="px-4 pt-3 text-center text-[13px] text-ink/80 sm:text-[14px]">
  {d.announce.text} <MoreLink href={callsHref}>{d.announce.more}</MoreLink>
</div>

<section class="px-3 pt-4 sm:px-6 sm:pt-6">
  <div class="tile mx-auto max-w-[1180px] px-4 pb-4 pt-12 sm:px-8 sm:pb-8 sm:pt-16 lg:px-12">
    <div class="mx-auto max-w-[760px] text-center">
      <img
        src="/favicon.svg"
        alt=""
        width="96"
        height="96"
        class="hero-in mx-auto size-[72px] drop-shadow-[0_10px_18px_rgba(217,77,22,0.25)] sm:size-24"
      />
      <Eyebrow class="hero-in mt-5" style="--delay:40ms">{h.eyebrow}</Eyebrow>
      <h1 class="headline hero-in mt-1 text-[56px] sm:text-[80px]" style="--delay:60ms">FixNote</h1>
      <p class="hero-in mt-1 text-[24px] font-semibold leading-tight tracking-[-0.025em] sm:text-[32px]" style="--delay:90ms">
        {h.subtitle}
      </p>
      <p class="hero-in lead mx-auto mt-5 max-w-[600px] text-[17px] sm:text-[19px]" style="--delay:120ms">
        {h.lead}
      </p>
      <div class="hero-in mt-8 flex flex-wrap items-center justify-center gap-3" style="--delay:180ms">
        <Pill
          href={downloadPage}
          id="hero-download"
          data-windows={h.downloadFor.windows}
          data-mac={h.downloadFor.mac}
          data-windows-href={DOWNLOADS.windows}
          data-mac-href={`${downloadPage}#mac`}
        >
          <Download size={18} /> <span>{h.download}</span>
        </Pill>
        <Pill href={localePath(lang, '/features/')} variant="outline">{h.more}</Pill>
      </div>
      <p class="hero-in mt-5 text-[13px] text-muted" style="--delay:220ms">{h.platforms}<Sup n={1} /></p>
    </div>
    <div class="hero-in mx-auto mt-12 max-w-[1040px] sm:mt-14" style="--delay:280ms">
      <Shot lang={lang} alt={h.shotAlt} />
    </div>
  </div>
</section>

<script is:inline>
  // Point the main button at the visitor's system. Windows gets the installer; on a Mac the
  // download page asks which chip (the browser can't tell Apple Silicon from Intel reliably).
  ;(() => {
    const b = document.getElementById('hero-download')
    const ua = navigator.userAgent
    const os = /Windows/.test(ua) ? 'windows' : /Macintosh/.test(ua) && !('ontouchend' in document) ? 'mac' : ''
    if (!b || !os) return
    b.href = b.dataset[`${os}Href`]
    b.querySelector('span').textContent = b.dataset[os]
  })()
</script>
