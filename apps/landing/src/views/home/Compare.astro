---
import CompareTable from '../../components/CompareTable.astro'
import Lines from '../../components/Lines.astro'
import Mark from '../../components/Mark.astro'
import More from '../../components/More.astro'
import { APPS, RIVALS } from '../../data/apps'
import { type Lang, t } from '../../i18n'
import { topicHref } from '../../lib/blog'
import { fill, vsPath } from '../../lib/pages'

/** FixNote next to the apps people weigh it against, with a link to the full review of the field. */
interface Props {
  lang: Lang
}
const { lang } = Astro.props
const c = t(lang).compare
const guide = await topicHref(lang, 'best-ai-note-apps', '/blog/')
---

<section id="compare" class="section-pad bg-white">
  <header class="section-header">
    <h2 class="typo-section-headline"><Lines text={c.headline} wide /></h2>
    <p class="typo-intro mx-auto mt-5 max-w-[40rem] text-muted">{c.lead}</p>
    <More href={guide} class="typo-intro mt-3 inline-block">{c.more}</More>
  </header>
  <div class="content">
    <ul class="typo-caption flex flex-wrap items-center justify-center gap-x-7 gap-y-2 text-muted">
      <li class="inline-flex items-center gap-2"><Mark mark="yes" />{c.included}</li>
      <li class="inline-flex items-center gap-2"><Mark mark="part" />{c.limited}</li>
      <li class="inline-flex items-center gap-2"><Mark mark="no" />{c.missing}</li>
    </ul>
    <p class="typo-caption mt-8 text-center text-muted small:hidden">{c.swipe}</p>
    <div class="mt-10 max-[734px]:mt-4">
      <CompareTable lang={lang} apps={['fixnote', ...RIVALS]} />
    </div>
    <p class="typo-caption mt-8 text-center text-muted">{c.footnote}</p>
    <nav aria-label={c.detailed} class="mt-10 text-center">
      <p class="typo-caption font-semibold text-muted">{c.detailed}</p>
      <ul class="mt-3 flex flex-wrap justify-center gap-x-7 gap-y-2">
        {
          RIVALS.map((rival) => (
            <li>
              <More href={vsPath(lang, rival)} class="typo-body">
                {fill(c.vsLink, { name: APPS[rival].name })}
              </More>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</section>
