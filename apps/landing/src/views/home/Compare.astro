---
import Lines from '../../components/Lines.astro'
import More from '../../components/More.astro'
import { type Lang, t } from '../../i18n'

/** Free and Pro side by side: a legend, rows grouped by where the work happens, Pro highlighted. */
interface Props {
  lang: Lang
}
const { lang } = Astro.props
const c = t(lang).compare
const plans = [
  { key: 'pro', ...c.pro, highlight: true },
  { key: 'free', ...c.free, highlight: false },
] as const
type Mark = 'yes' | 'part' | 'no'
/** The round marks of the table and its legend (static SVG, no text inside). */
const mark = (m: Mark) =>
  m === 'yes'
    ? '<span class="mx-auto flex h-6 w-6 items-center justify-center rounded-full bg-brand/10 text-brand"><svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="m2.5 6.2 2.3 2.3 4.7-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>'
    : m === 'part'
      ? '<span class="mx-auto flex h-6 w-6 items-center justify-center rounded-full bg-ember/10 text-ember"><span class="h-[2px] w-2.5 rounded-full bg-current"></span></span>'
      : '<span class="mx-auto block h-[2px] w-3 rounded-full bg-line"></span>'
const label = (m: Mark) => (m === 'yes' ? c.included : m === 'part' ? c.limited : c.missing)
---

<section id="compare" class="section-pad bg-white">
  <header class="section-header">
    <h2 class="typo-section-headline"><Lines text={c.headline} wide /></h2>
    <p class="typo-intro mx-auto mt-5 max-w-[40rem] text-muted">{c.lead}</p>
    <More href="#pricing" class="typo-intro mt-3 inline-block">{c.more}</More>
  </header>
  <div class="content">
    <ul class="typo-caption flex flex-wrap items-center justify-center gap-x-7 gap-y-2 text-muted">
      <li class="inline-flex items-center gap-2"><Fragment set:html={mark('yes')} />{c.included}</li>
      <li class="inline-flex items-center gap-2"><Fragment set:html={mark('part')} />{c.limited}</li>
      <li class="inline-flex items-center gap-2"><Fragment set:html={mark('no')} />{c.missing}</li>
    </ul>
    <div class="relative mt-10 overflow-x-auto max-[734px]:mt-6">
      <table class="w-full table-fixed border-collapse text-left">
        <colgroup>
          <col class="w-[52%] small:w-[46%]" />
          <col />
          <col />
        </colgroup>
        <thead>
          <tr>
            <th class="bg-white"></th>
            {
              plans.map((plan) => (
                <th class:list={['px-2 pt-6 pb-6 text-center align-bottom', plan.highlight && 'rounded-t-[18px] bg-panel']}>
                  <div class="flex flex-col items-center gap-2.5">
                    <img src="/favicon.svg" alt="" width="48" height="48" class:list={['h-12 w-12', !plan.highlight && 'opacity-60 grayscale']} />
                    <span class:list={['typo-caption leading-tight font-semibold', plan.highlight ? 'text-brand' : 'text-ink']}>
                      FixNote {plan.name}
                    </span>
                    <span class="typo-caption text-muted">{plan.price}</span>
                  </div>
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            c.groups.map((group) => (
              <>
                <tr>
                  <th class="typo-eyebrow bg-white pt-10 pb-3 text-ink">{group.title}</th>
                  <td class="bg-panel" />
                  <td />
                </tr>
                {group.rows.map((row) => (
                  <tr class="border-t border-line">
                    <th class="bg-white py-4 pr-4 font-normal">
                      <span class="typo-body block text-ink">{row.label}</span>
                      {row.note && <span class="typo-caption block text-muted">{row.note}</span>}
                    </th>
                    {plans.map((plan) => {
                      const m = row[plan.key] as Mark
                      return (
                        <td class:list={['px-3 py-4 text-center', plan.highlight && 'bg-panel']}>
                          <Fragment set:html={mark(m)} />
                          <span class="sr-only">{label(m)}</span>
                        </td>
                      )
                    })}
                  </tr>
                ))}
              </>
            ))
          }
          <tr>
            <td class="bg-white"></td>
            <td class="h-6 rounded-b-[18px] bg-panel"></td>
            <td class="h-6"></td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="typo-caption mt-8 text-center text-muted">{c.footnote}</p>
  </div>
</section>

