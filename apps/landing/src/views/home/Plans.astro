---
import { Image } from 'astro:assets'
import glow from '../../assets/landing/pro-glow.png'
import { type Lang, localePath, t } from '../../i18n'

/**
 * Pricing: Free and Pro side by side, as the design draws them. The switch shows the monthly or
 * the yearly price of Pro with no script (a checkbox and :has in home.css). Each price is a sharp
 * layer and a pixelated copy (`.px`) that the swap animation crossfades.
 */
interface Props {
  lang: Lang
}
const { lang } = Astro.props
const c = t(lang).landing.plans
const download = localePath(lang, '/download/')
---

<section id="pricing" class="lp plans" aria-labelledby="plans-title">
  <div class="lp-head fx">
    <p class="lp-eyebrow">{c.eyebrow}</p>
    <h2 id="plans-title" class="lp-title plans-title">
      <span class="orange">{c.title1}</span>
      <span>{c.title2}</span>
    </h2>
    <p class="lp-lead plans-lead">{c.lead}</p>
  </div>
  <div class="plans-switch fx">
    <span aria-hidden="true">{c.monthly}</span>
    <label class="switch">
      <input type="checkbox" id="plans-yearly" class="sr-only" />
      <span class="sr-only">{c.annually}</span>
      <span class="switch-dot" aria-hidden="true"></span>
      <span></span>
    </label>
    <span aria-hidden="true">{c.annually}</span>
  </div>
  <div class="plans-cards">
    <article class="plan plan-free fx">
      <div class="plan-group">
        <div class="plan-head">
          <h3 class="plan-name">{c.free.name}</h3>
          <p class="plan-price">{c.free.price}</p>
          <p class="plan-meta">
            <span>{c.free.note}</span>
            <span class="plan-dot" aria-hidden="true"></span>
            <span>{c.free.noAccount}</span>
          </p>
        </div>
        <ul class="plan-list">{c.free.items.map((item) => <li>{item}</li>)}</ul>
      </div>
      <a href={download} class="btn-pill plan-button plan-button-soft">{c.free.button}</a>
    </article>
    <article class="plan plan-pro fx" style="transition-delay:90ms">
      <Image src={glow} alt="" class="plan-glow" widths={[468, 936]} sizes="468px" loading="lazy" />
      <div class="plan-head">
        <h3 class="plan-name">{c.pro.name}</h3>
        <p class="plan-price orange">
          <span class="swap"
            ><span class="per-month"><span class="sharp">{c.pro.month}</span><span class="px" aria-hidden="true">{c.pro.month}</span></span><span class="per-year"><span class="sharp">{c.pro.year}</span><span class="px" aria-hidden="true">{c.pro.year}</span></span></span
          >
        </p>
        <p class="plan-meta">
          <span class="swap swap-small"
            ><span class="per-month"><span class="sharp">{c.pro.perYear}</span><span class="px" aria-hidden="true">{c.pro.perYear}</span></span><span class="per-year"><span class="sharp">{c.pro.perMonth}</span><span class="px" aria-hidden="true">{c.pro.perMonth}</span></span></span
          >
          <span class="plan-dot" aria-hidden="true"></span>
          <span>{c.pro.cancel}</span>
        </p>
      </div>
      <ul class="plan-list">{c.pro.items.map((item) => <li>{item}</li>)}</ul>
      <a href={download} class="btn-pill btn-pill-orange plan-button">{c.pro.button}</a>
    </article>
  </div>
  <!-- Pixelate filters for the price swap (home.css): sample the middle of each N×N tile and grow
       that dot to fill exactly the tile (no overlap, so the pixels keep the letters' weight). -->
  <svg class="sr-only" width="0" height="0" aria-hidden="true" focusable="false">
    {
      [3, 4, 6, 8, 10].map((n) => {
        const dot = n % 2 ? 1 : 2
        const r = (n - dot) / 2
        return (
          <filter id={`px-${n}`} x="0" y="0" color-interpolation-filters="sRGB">
            <feFlood x={r} y={r} width={dot} height={dot} />
            <feComposite width={n} height={n} />
            <feTile result="grid" />
            <feComposite in="SourceGraphic" in2="grid" operator="in" />
            <feMorphology operator="dilate" radius={r} />
          </filter>
        )
      })
    }
  </svg>
</section>
