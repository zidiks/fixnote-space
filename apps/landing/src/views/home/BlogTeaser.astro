---
import CardRow from '../../components/CardRow.astro'
import Headline from '../../components/Headline.astro'
import MoreLink from '../../components/MoreLink.astro'
import PostCard from '../../components/PostCard.astro'
import { type Lang, localePath, t } from '../../i18n'
import { getPosts } from '../../lib/blog'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const d = t(lang)
const b = d.blogTeaser
const posts = (await getPosts(lang)).slice(0, 9)
---

{
  posts.length > 0 && (
    <section class="py-20 sm:py-28">
      <div class="px-4 text-center">
        <Headline parts={b.headline} class="text-[36px] sm:text-[56px] lg:text-[64px]" />
        <p class="reveal lead mx-auto mt-4 max-w-[560px] text-[17px] sm:text-[21px]">{b.lead}</p>
        <div class="reveal mt-4"><MoreLink href={localePath(lang, '/blog/')} class="text-[17px] sm:text-[19px]">{b.all}</MoreLink></div>
      </div>
      <div class="mt-12">
        <CardRow prev={d.reasons.prev} next={d.reasons.next}>
          {posts.map((post) => (
            <PostCard post={post} lang={lang} row />
          ))}
        </CardRow>
      </div>
    </section>
  )
}
