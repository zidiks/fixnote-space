---
import ArrowRight from '@lucide/astro/icons/arrow-right'
import PostCard from '../../components/PostCard.astro'
import SectionHeader from '../../components/SectionHeader.astro'
import { type Lang, localePath, t } from '../../i18n'
import { getPosts } from '../../lib/blog'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const d = t(lang).blogTeaser
const posts = (await getPosts(lang)).slice(0, 3)
---

{
  posts.length > 0 && (
    <section class="px-4 py-24 sm:px-6 sm:py-32">
      <SectionHeader eyebrow={d.eyebrow} parts={d.headline} />
      <div class="mx-auto mt-14 grid max-w-[1100px] gap-4 md:grid-cols-3">
        {posts.map((post, i) => (
          <PostCard post={post} lang={lang} delay={i * 80} />
        ))}
      </div>
      <div class="reveal mt-10 text-center">
        <a href={localePath(lang, '/blog/')} class="inline-flex items-center gap-1.5 text-[15px] font-medium text-brand-deep hover:underline">
          {d.all} <ArrowRight size={16} />
        </a>
      </div>
    </section>
  )
}
