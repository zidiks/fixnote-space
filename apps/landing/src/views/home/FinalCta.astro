---
import Download from '@lucide/astro/icons/download'
import MoreLink from '../../components/MoreLink.astro'
import Pill from '../../components/Pill.astro'
import { APP_URL, type Lang, localePath, t } from '../../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const d = t(lang).cta
---

<section class="px-3 py-10 sm:px-6">
  <div class="tile mx-auto max-w-[1180px] px-6 py-16 text-center sm:py-20">
    <img src="/favicon.svg" alt="" width="64" height="64" class="reveal mx-auto size-16" />
    <h2 class="headline reveal mt-6 text-[36px] sm:text-[52px]">{d.title}</h2>
    <p class="reveal lead mx-auto mt-4 max-w-[520px] text-[17px] sm:text-[19px]" style="--delay:120ms">{d.lead}</p>
    <div class="reveal mt-8 flex flex-wrap items-center justify-center gap-5" style="--delay:200ms">
      <Pill href={localePath(lang, '/download/')}><Download size={18} /> {d.download}</Pill>
      <MoreLink href={APP_URL} class="text-[17px]">{d.open}</MoreLink>
    </div>
  </div>
</section>
