---
import Download from '@lucide/astro/icons/download'
import Headline from '../../components/Headline.astro'
import MoreLink from '../../components/MoreLink.astro'
import Pill from '../../components/Pill.astro'
import { type Lang, localePath, t } from '../../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const d = t(lang)
const s = d.steps
---

<section class="px-4 pb-24 sm:px-6 sm:pb-32">
  <Headline parts={s.headline} class="text-center text-[28px] sm:text-[36px]" />
  <ol class="mx-auto mt-10 grid max-w-[820px] gap-4 sm:grid-cols-3">
    {
      s.items.map((step, i) => (
        <li class="reveal tile px-6 py-8 text-center" style={`--delay:${i * 80}ms`}>
          <span class="text-[44px] font-semibold leading-none text-faint">{i + 1}</span>
          <h3 class="mt-4 text-[19px] font-semibold tracking-[-0.02em]">{step.title}</h3>
          <p class="mt-2 text-[15px] leading-[1.5] text-muted">{step.text}</p>
        </li>
      ))
    }
  </ol>
  <div class="reveal mt-10 flex flex-wrap items-center justify-center gap-5">
    <Pill href={localePath(lang, '/download/')} size="base"><Download size={16} /> {d.hero.download}</Pill>
    <MoreLink href={localePath(lang, '/download/')}>{s.all}</MoreLink>
  </div>
</section>
