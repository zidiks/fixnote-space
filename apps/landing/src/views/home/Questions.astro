---
import Headline from '../../components/Headline.astro'
import { type Lang, t } from '../../i18n'

/** Two endless rows of example questions moving in opposite directions (CSS only). */
interface Props {
  lang: Lang
}
const d = t(Astro.props.lang).questions
const rows = [
  { items: d.top, reverse: false },
  { items: d.bottom, reverse: true },
]
---

<section class="overflow-hidden bg-white py-20 sm:py-28">
  <div class="px-4 text-center">
    <Headline parts={d.headline} class="text-[36px] sm:text-[56px] lg:text-[64px]" />
    <p class="reveal lead mx-auto mt-4 max-w-[560px] text-[17px] sm:text-[21px]">{d.lead}</p>
  </div>
  <div class="reveal mt-12 space-y-3 sm:mt-14">
    {
      rows.map((row) => (
        <div class="marquee-track overflow-hidden">
          <ul class="marquee flex w-max" data-reverse={row.reverse ? '' : undefined}>
            {[0, 1, 2, 3].flatMap((copy) =>
              row.items.map((q) => (
                <li
                  aria-hidden={copy > 0 ? 'true' : undefined}
                  class="mr-3 whitespace-nowrap rounded-full bg-canvas px-5 py-3 text-[15px] font-medium tracking-[-0.01em] sm:text-[17px]"
                >
                  {q}
                </li>
              )),
            )}
          </ul>
        </div>
      ))
    }
  </div>
</section>
