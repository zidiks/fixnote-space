---
import Check from '@lucide/astro/icons/check'
import FileText from '@lucide/astro/icons/file-text'
import Search from '@lucide/astro/icons/search'
import Send from '@lucide/astro/icons/send'
import Sparkles from '@lucide/astro/icons/sparkles'
import Eyebrow from '../../components/Eyebrow.astro'
import Lines from '../../components/Lines.astro'
import MoreLink from '../../components/MoreLink.astro'
import Pill from '../../components/Pill.astro'
import Sup from '../../components/Sup.astro'
import { type Lang, localePath, t } from '../../i18n'
import { topicHref } from '../../lib/blog'

/** Four feature tiles, two by two, each with a small picture of the app drawn in CSS. */
interface Props {
  lang: Lang
}
const { lang } = Astro.props
const d = t(lang)
const v = d.tiles
const download = localePath(lang, '/download/')
const tiles = [
  {
    key: 'assistant',
    dark: true,
    href: await topicHref(lang, 'assistant-agent', '/features/#assistant'),
    note: 2,
  },
  {
    key: 'voice',
    dark: false,
    href: await topicHref(lang, 'voice-on-device', '/features/#voice'),
    note: 0,
  },
  {
    key: 'telegram',
    dark: false,
    href: await topicHref(lang, 'telegram-capture', '/features/#capture'),
    note: 0,
  },
  {
    key: 'search',
    dark: false,
    href: await topicHref(lang, 'search', '/features/#search'),
    note: 0,
  },
] as const
const bars = [0.45, 0.8, 0.55, 1, 0.7, 0.4, 0.9, 0.6, 0.35, 0.75, 0.5, 0.85, 0.6, 0.3, 0.7, 0.5]
---

<section class="px-3 pt-3 sm:px-6 sm:pt-5">
  <div class="mx-auto grid max-w-[1180px] gap-3 sm:gap-5 lg:grid-cols-2">
    {
      tiles.map((tile, i) => {
        const text = v[tile.key]
        return (
          <article
            class:list={[
              'reveal flex flex-col overflow-hidden rounded-[28px] px-5 pt-12 text-center sm:rounded-[32px] sm:px-10 sm:pt-14',
              tile.dark ? 'bg-night text-white' : 'bg-white',
            ]}
            style={`--delay:${(i % 2) * 80}ms`}
          >
            <Eyebrow tone={tile.dark ? 'ai' : 'muted'}>{text.eyebrow}</Eyebrow>
            <h2 class="headline mt-2 text-[32px] sm:text-[44px]"><Lines text={text.title} /></h2>
            <p class:list={['mx-auto mt-4 max-w-[440px] text-[16px] leading-[1.5] sm:text-[17px]', tile.dark ? 'text-white/70' : 'text-muted']}>
              {text.text}
              {tile.note > 0 && <Sup n={tile.note} />}
            </p>
            <div class="mt-6 flex items-center justify-center gap-5">
              <Pill href={download} size="base">{d.hero.download}</Pill>
              <MoreLink href={tile.href} class={tile.dark ? '!text-[#ff9a66]' : ''}>{d.hero.more}</MoreLink>
            </div>
            <div
              class:list={[
                'mt-10 flex h-[260px] flex-col justify-center gap-3 rounded-t-[20px] px-5 sm:mx-2 sm:h-[300px] sm:px-10',
                tile.dark ? 'backdrop-night' : 'backdrop',
              ]}
              aria-hidden="true"
            >
              {tile.key === 'assistant' && (
                <div class="mx-auto w-full max-w-[400px] space-y-3 text-left">
                  <div class="ml-auto w-fit rounded-2xl rounded-br-md bg-white/12 px-3.5 py-2 text-[14px] text-white">{v.assistant.question}</div>
                  <div class="rounded-2xl bg-[#1c1c1e] p-4 ring-1 ring-white/10">
                    <div class="flex items-center gap-1.5 text-[12px] font-medium text-white/55"><Sparkles size={13} class="text-brand" /> FixNote AI</div>
                    <p class="mt-2 text-[14px] leading-snug text-white/90">
                      {v.assistant.answer} <span class="rounded bg-brand/25 px-1 text-[11px] font-semibold text-[#ff9a66]">1</span>{' '}
                      <span class="rounded bg-brand/25 px-1 text-[11px] font-semibold text-[#ff9a66]">2</span>
                    </p>
                    <div class="mt-3 text-[10px] font-medium uppercase tracking-[0.1em] text-white/45">{v.assistant.sources}</div>
                    <div class="mt-1.5 flex flex-wrap gap-1.5 text-[12px] text-white/80">
                      <span class="rounded-full px-2 py-0.5 ring-1 ring-white/15"><b class="text-[#ff9a66]">1</b> {v.assistant.source1}</span>
                      <span class="rounded-full px-2 py-0.5 ring-1 ring-white/15"><b class="text-[#ff9a66]">2</b> {v.assistant.source2}</span>
                    </div>
                  </div>
                </div>
              )}
              {tile.key === 'voice' && (
                <div class="mx-auto w-full max-w-[400px] rounded-2xl bg-white p-5 text-left shadow-[0_16px_40px_-18px_rgba(60,30,10,0.35)]">
                  <div class="flex items-center gap-2 text-[13px] font-medium text-brand-deep">
                    <span class="fx-blink size-2 rounded-full bg-brand" /> {v.voice.recording}
                    <span class="ml-auto font-mono text-[12px] text-muted">0:07</span>
                  </div>
                  <div class="mt-4 flex h-10 items-center gap-1">
                    {bars.map((h, j) => (
                      <span class="fx-pulse w-1.5 rounded-full bg-ink/80" style={`height:${h * 100}%;animation-delay:${j * 90}ms`} />
                    ))}
                  </div>
                  <p class="mt-4 text-[15px] leading-snug">
                    {v.voice.sample}<span class="fx-blink ml-0.5 inline-block h-[1.05em] w-[2px] translate-y-[2px] bg-brand" />
                  </p>
                </div>
              )}
              {tile.key === 'telegram' && (
                <div class="mx-auto w-full max-w-[400px] space-y-3 text-left">
                  <div class="flex items-end justify-end gap-2">
                    <div class="max-w-[260px] rounded-2xl rounded-br-md bg-[#2aa3ef] px-3.5 py-2.5 text-[14px] leading-snug text-white shadow-sm">{v.telegram.message}</div>
                    <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-[#2aa3ef] text-white"><Send size={14} /></span>
                  </div>
                  <div class="rounded-2xl bg-white p-4 shadow-[0_16px_40px_-18px_rgba(60,30,10,0.35)]">
                    <div class="flex items-center gap-1.5 text-[12px] font-medium text-muted"><FileText size={13} /> {v.telegram.note}</div>
                    <p class="mt-2 text-[15px] font-semibold tracking-[-0.01em]">{v.telegram.message}</p>
                    <div class="mt-3 flex items-center gap-1.5 text-[12px] text-[#23883f]"><Check size={13} stroke-width={3} /> E2EE</div>
                  </div>
                </div>
              )}
              {tile.key === 'search' && (
                <div class="mx-auto w-full max-w-[400px] rounded-2xl bg-white p-2 text-left shadow-[0_16px_40px_-18px_rgba(60,30,10,0.35)]">
                  <div class="flex items-center gap-2 rounded-xl bg-canvas px-3 py-2.5 text-[15px]">
                    <Search size={16} class="text-muted" /> {v.search.query}<span class="fx-blink -ml-1.5 inline-block h-[1.05em] w-[2px] bg-brand" />
                    <span class="ml-auto rounded-md bg-white px-1.5 py-0.5 text-[11px] text-muted ring-1 ring-line">Ctrl K</span>
                  </div>
                  <ul class="mt-1 space-y-0.5 text-[14px]">
                    <li class="flex items-center gap-2 rounded-lg bg-brand/10 px-3 py-2"><FileText size={14} class="text-brand-deep" /> {v.search.result1}</li>
                    <li class="flex items-center gap-2 px-3 py-2"><FileText size={14} class="text-muted" /> {v.search.result2}</li>
                  </ul>
                  <div class="px-3 pt-1 text-[10px] font-medium uppercase tracking-[0.1em] text-muted">{v.search.similar}</div>
                  <div class="flex items-center gap-2 px-3 py-2 text-[14px]"><Sparkles size={14} class="text-muted" /> {v.search.result3}</div>
                </div>
              )}
            </div>
          </article>
        )
      })
    }
  </div>
</section>
