---
import AudioLines from '@lucide/astro/icons/audio-lines'
import CalendarCheck from '@lucide/astro/icons/calendar-check'
import Check from '@lucide/astro/icons/check'
import ChevronRight from '@lucide/astro/icons/chevron-right'
import PhoneCall from '@lucide/astro/icons/phone-call'
import ScanText from '@lucide/astro/icons/scan-text'
import WandSparkles from '@lucide/astro/icons/wand-sparkles'
import Headline from '../../components/Headline.astro'
import MoreLink from '../../components/MoreLink.astro'
import Sup from '../../components/Sup.astro'
import { type Lang, t } from '../../i18n'
import { topicHref } from '../../lib/blog'

/** A call summary as the app writes it, then four smaller ways notes get made. */
interface Props {
  lang: Lang
}
const { lang } = Astro.props
const d = t(lang).showcase
const c = d.call
type Look = { icon: typeof PhoneCall; tint: string; topic: string; fallback: string; note: number }
const look: Record<string, Look> = {
  calls: {
    icon: PhoneCall,
    tint: 'from-[#ff9a5a] to-[#e2501a]',
    topic: 'call-notes',
    fallback: '/features/',
    note: 3,
  },
  ocr: {
    icon: ScanText,
    tint: 'from-[#6aa8ff] to-[#2d64b3]',
    topic: 'ocr',
    fallback: '/features/',
    note: 0,
  },
  daily: {
    icon: CalendarCheck,
    tint: 'from-[#4cd07a] to-[#23883f]',
    topic: 'daily-note',
    fallback: '/features/#daily',
    note: 0,
  },
  tidy: {
    icon: WandSparkles,
    tint: 'from-[#c58bff] to-[#7b4ad6]',
    topic: 'tidy',
    fallback: '/features/#daily',
    note: 0,
  },
}
const items = await Promise.all(
  d.items.map(async (item) => {
    const l: Look = look[item.id] ?? (look.calls as Look)
    return { ...item, ...l, href: await topicHref(lang, l.topic, l.fallback) }
  }),
)
---

<section class="px-3 py-24 sm:px-6 sm:py-32">
  <Headline parts={d.headline} class="mx-auto max-w-[1040px] text-center text-[36px] sm:text-[52px] lg:text-[60px]" />
  <div class="reveal tile mx-auto mt-12 max-w-[940px] p-3 sm:mt-16 sm:p-5">
    <div class="backdrop flex justify-center rounded-[20px] px-4 py-10 sm:rounded-[24px] sm:px-10 sm:py-14" aria-hidden="true">
      <div class="w-full max-w-[560px] rounded-2xl bg-white p-6 text-left shadow-[0_30px_70px_-30px_rgba(60,30,10,0.45)] sm:p-8">
        <div class="flex items-center gap-2 text-[12px] font-medium text-muted"><AudioLines size={14} class="text-brand" /> {c.meta}</div>
        <p class="mt-2 text-[24px] font-bold tracking-[-0.03em]">{c.title}</p>
        <p class="mt-5 text-[15px] font-semibold">{c.brief}</p>
        <p class="mt-1 text-[15px] leading-snug text-ink/80">{c.briefText}</p>
        <p class="mt-4 text-[15px] font-semibold">{c.decisions}</p>
        <p class="mt-1 text-[15px] leading-snug text-ink/80">• {c.decision}</p>
        <p class="mt-4 text-[15px] font-semibold">{c.tasks}</p>
        <ul class="mt-1.5 space-y-1.5 text-[15px] text-ink/80">
          <li class="flex items-center gap-2.5"><span class="flex size-[18px] items-center justify-center rounded-[5px] bg-brand text-white"><Check size={12} stroke-width={3} /></span><span class="line-through decoration-ink/30">{c.task1}</span></li>
          <li class="flex items-center gap-2.5"><span class="size-[18px] rounded-[5px] ring-[1.5px] ring-inset ring-ink/30" />{c.task2}</li>
        </ul>
        <div class="mt-5 flex items-center gap-1.5 border-t border-line pt-4 text-[14px] text-muted"><ChevronRight size={15} /> {c.transcript}</div>
      </div>
    </div>
  </div>
  <ul class="mx-auto mt-14 grid max-w-[1040px] gap-x-6 gap-y-12 sm:mt-16 sm:grid-cols-2 lg:grid-cols-4">
    {
      items.map((item, i) => {
        const Icon = item.icon
        return (
          <li class="reveal text-center" style={`--delay:${i * 70}ms`}>
            <span class={`mx-auto flex size-12 items-center justify-center rounded-[14px] bg-gradient-to-b text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.35)] ${item.tint}`}>
              <Icon size={23} />
            </span>
            <h3 class="mt-4 text-[19px] font-semibold tracking-[-0.02em]">{item.title}</h3>
            <p class="mx-auto mt-2 max-w-[260px] text-[15px] leading-[1.5] text-muted">
              {item.text}
              {item.note > 0 && <Sup n={item.note} />}
            </p>
            <MoreLink href={item.href} class="mt-3 text-[15px]">{d.more}</MoreLink>
          </li>
        )
      })
    }
  </ul>
</section>
