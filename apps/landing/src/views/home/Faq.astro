---
import { type Lang, PRIVACY_EMAIL, t } from '../../i18n'

/** Questions as native <details>, one open at a time is not enforced. */
interface Props {
  lang: Lang
}
const { lang } = Astro.props
const f = t(lang).faq
---

<section id="faq" class="section-pad bg-white">
  <header class="section-header">
    <h2 class="typo-section-headline">{f.headline}</h2>
  </header>
  <div class="content">
    <div class="mx-auto max-w-[820px] border-t border-line">
      {
        f.items.map((item) => (
          <details class="faq-item border-b border-line">
            <summary class="typo-eyebrow flex items-center justify-between gap-6 py-6 text-left text-ink max-[734px]:py-5">
              {item.q}
              <svg class="faq-icon h-4 w-4 shrink-0 text-muted transition-transform duration-300" viewBox="0 0 16 16" aria-hidden="true">
                <path d="m3 6 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <div class="pr-12 pb-7 max-[734px]:pr-0">
              <p class="typo-body text-ink">{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
    <p class="typo-body mt-12 text-center text-muted">
      {f.more} <a href={`mailto:${PRIVACY_EMAIL}`} class="link">{PRIVACY_EMAIL}</a>.
    </p>
  </div>
</section>
