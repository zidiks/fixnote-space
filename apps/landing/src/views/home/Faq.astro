---
import ArrowLink from '../../components/ArrowLink.astro'
import { CONTACT_EMAIL, type Lang, t } from '../../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const c = t(lang).landing.faq
---

<section id="faq" class="home-faq" aria-labelledby="home-faq-title">
  <div class="home-faq-head">
    <div>
      <p class="lp-eyebrow">{c.eyebrow}</p>
      <h2 id="home-faq-title"><span>{c.title1}</span><span class="orange">{c.title2}</span>{' '}<span>{c.title3}</span></h2>
    </div>
    <ArrowLink href={`mailto:${CONTACT_EMAIL}`} class="voice-button">{c.contact}</ArrowLink>
  </div>
  <div class="home-faq-list">
    {c.items.map((item, i) => (
      <details name="home-faq" open={i === 2}>
        <summary>{item.q}<span class="faq-sign" aria-hidden="true"></span></summary>
        <div class="home-faq-answer"><p>{item.a}</p></div>
      </details>
    ))}
  </div>
</section>

<script is:inline>
  ;(() => {
    const list = document.querySelector('.home-faq-list')
    if (!list || !Element.prototype.animate) return
    const reduced = matchMedia('(prefers-reduced-motion: reduce)')
    const items = [...list.querySelectorAll('details')].map((el) => {
      // Keep native details as the accessible, script-free fallback. Control the group ourselves
      // so opening another answer doesn't make the browser snap the previous one shut.
      el.removeAttribute('name')
      el.setAttribute('data-animated', '')
      el.toggleAttribute('data-expanded', el.open)
      return {
        el,
        summary: el.querySelector('summary'),
        panel: el.querySelector('.home-faq-answer'),
        text: el.querySelector('.home-faq-answer p'),
        expanded: el.open,
        height: null,
        reveal: null,
        revision: 0,
      }
    })
    const settle = (item) => {
      item.el.open = item.expanded
      item.panel.style.removeProperty('height')
      item.height?.cancel()
      item.reveal?.cancel()
      item.height = item.reveal = null
    }
    const change = (item, expanded) => {
      const wasOpen = item.el.open
      const current = wasOpen ? getComputedStyle(item.panel).height : '0px'
      const paint = getComputedStyle(item.text)
      const from = wasOpen
        ? { opacity: paint.opacity, transform: paint.transform, filter: paint.filter }
        : { opacity: 0, transform: 'translateY(6px)', filter: 'blur(2px)' }
      const revision = ++item.revision
      item.expanded = expanded
      item.el.toggleAttribute('data-expanded', expanded)
      item.summary.setAttribute('aria-expanded', String(expanded))
      item.height?.cancel()
      item.reveal?.cancel()
      if (reduced.matches) {
        settle(item)
        return
      }
      item.el.open = true
      // scrollHeight rounds to whole pixels. Animate to the same fractional layout height that
      // height:auto will use afterwards, so the following questions don't shift at hand-over.
      item.panel.style.height = 'auto'
      const full = getComputedStyle(item.panel).height
      item.panel.style.height = current
      item.height = item.panel.animate(
        [{ height: current }, { height: expanded ? full : '0px' }],
        { duration: 260, delay: expanded ? 0 : 80, easing: 'cubic-bezier(.25,.1,.25,1)', fill: 'both' },
      )
      item.reveal = item.text.animate(
        [from, expanded
          ? { opacity: 1, transform: 'translateY(0)', filter: 'blur(0px)' }
          : { opacity: 0, transform: 'translateY(6px)', filter: 'blur(2px)' }],
        { duration: expanded ? 170 : 120, delay: expanded ? 150 : 0, easing: 'ease-out', fill: 'both' },
      )
      Promise.all([item.height.finished, item.reveal.finished]).then(() => {
        if (item.revision === revision) settle(item)
      }).catch(() => {}) // A new click reverses from the current frame instead of jumping.
    }
    for (const item of items) {
      item.summary.addEventListener('click', (event) => {
        event.preventDefault()
        const expanded = !item.expanded
        if (expanded) for (const other of items) {
          if (other !== item && other.expanded) change(other, false)
        }
        change(item, expanded)
      })
    }
    reduced.addEventListener('change', () => {
      if (reduced.matches) for (const item of items) {
        item.revision++
        settle(item)
      }
    })
  })()
</script>
