---
import Check from '@lucide/astro/icons/check'
import FolderInput from '@lucide/astro/icons/folder-input'
import Heading from '@lucide/astro/icons/heading'
import Merge from '@lucide/astro/icons/merge'
import Mic from '@lucide/astro/icons/mic'
import Send from '@lucide/astro/icons/send'
import Sparkles from '@lucide/astro/icons/sparkles'
import SectionHeader from '../../components/SectionHeader.astro'
import { type Lang, t } from '../../i18n'

/** Three steps, each with a small drawn-in-CSS picture of the app (no images to load). */
interface Props {
  lang: Lang
}
const d = t(Astro.props.lang).how
const v = d.visual
const bars = [0.45, 0.8, 0.55, 1, 0.7, 0.4, 0.9, 0.6, 0.35, 0.75, 0.5, 0.85]
const tidy = [
  { icon: FolderInput, text: v.tidyMove },
  { icon: Heading, text: v.tidyTitleSuggestion },
  { icon: Merge, text: v.tidyMerge },
]
---

<section id="how" class="px-4 py-24 sm:px-6 sm:py-32">
  <SectionHeader eyebrow={d.eyebrow} parts={d.headline} lead={d.lead} />
  <ol class="mx-auto mt-16 grid max-w-[1100px] gap-5 sm:mt-20 lg:grid-cols-3">
    {
      d.steps.map((step, i) => (
        <li class="reveal flex flex-col rounded-[28px] bg-white p-3 shadow-[0_1px_2px_rgba(27,26,24,0.05)] ring-1 ring-black/[0.04]" style={`--delay:${i * 100}ms`}>
          <div class="flex h-[248px] flex-col justify-center gap-3 rounded-[20px] bg-canvas p-5" aria-hidden="true">
            {i === 0 && (
              <>
                <div class="rounded-2xl bg-white p-4 shadow-sm">
                  <div class="flex items-center gap-2 text-[13px] font-medium text-brand-deep">
                    <span class="fx-blink size-2 rounded-full bg-brand" /> {v.recording}
                  </div>
                  <div class="mt-3 flex h-8 items-center gap-1">
                    {bars.map((h, j) => (
                      <span class="fx-pulse w-1.5 rounded-full bg-ink/80" style={`height:${h * 100}%;animation-delay:${j * 90}ms`} />
                    ))}
                  </div>
                  <p class="mt-3 text-[14px] leading-snug text-ink/80">{v.voice}</p>
                </div>
                <div class="flex items-start gap-2.5 self-end">
                  <div class="max-w-[230px] rounded-2xl rounded-br-md bg-[#2aa3ef] px-3.5 py-2.5 text-[13px] leading-snug text-white shadow-sm">{v.telegram}</div>
                  <span class="mt-auto flex size-7 shrink-0 items-center justify-center rounded-full bg-[#2aa3ef] text-white"><Send size={14} /></span>
                </div>
              </>
            )}
            {i === 1 && (
              <>
                <div class="self-end rounded-2xl rounded-br-md bg-white px-3.5 py-2 text-[14px] shadow-sm">{v.question}</div>
                <div class="rounded-2xl bg-white p-4 shadow-sm">
                  <div class="flex items-center gap-1.5 text-[12px] font-medium text-muted"><Sparkles size={13} class="text-brand" /> FixNote</div>
                  <p class="mt-2 text-[14px] leading-snug">
                    {v.answer} <span class="rounded bg-[#fde2d3] px-1 text-[11px] font-semibold text-brand-deep">1</span>{' '}
                    <span class="rounded bg-[#fde2d3] px-1 text-[11px] font-semibold text-brand-deep">2</span>
                  </p>
                  <div class="mt-3 text-[10px] font-medium uppercase tracking-[0.1em] text-muted">{v.sources}</div>
                  <div class="mt-1.5 flex flex-wrap gap-1.5 text-[12px]">
                    <span class="rounded-full px-2 py-0.5 ring-1 ring-line"><b class="text-brand-deep">1</b> {v.source1}</span>
                    <span class="rounded-full px-2 py-0.5 ring-1 ring-line"><b class="text-brand-deep">2</b> {v.source2}</span>
                  </div>
                </div>
              </>
            )}
            {i === 2 && (
              <div class="rounded-2xl bg-white p-4 shadow-sm">
                <div class="flex items-center gap-1.5 text-[13px] font-semibold"><Sparkles size={14} class="text-brand" /> {v.tidyTitle}</div>
                <ul class="mt-3 space-y-2">
                  {tidy.map((row, j) => {
                    const Icon = row.icon
                    return (
                      <li class="flex items-center gap-2.5 rounded-xl bg-canvas px-2.5 py-2 text-[13px] leading-tight">
                        <Icon size={15} class="shrink-0 text-muted" />
                        <span class="min-w-0 flex-1">{row.text}</span>
                        {j === 0 ? (
                          <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-[#23883f] text-white"><Check size={12} stroke-width={3} /></span>
                        ) : (
                          <span class="shrink-0 rounded-full bg-ink px-2 py-0.5 text-[11px] font-medium text-white">{v.accept}</span>
                        )}
                      </li>
                    )
                  })}
                </ul>
              </div>
            )}
          </div>
          <div class="px-3 pb-4 pt-6">
            <div class="flex items-center gap-2 text-sm font-medium text-muted">
              {i === 0 ? <Mic size={15} /> : i === 1 ? <Sparkles size={15} /> : <Check size={15} />}
              {d.step} {i + 1}
            </div>
            <h3 class="mt-3 text-[22px] font-semibold leading-tight tracking-[-0.03em]">{step.title}</h3>
            <p class="mt-2.5 text-[15px] leading-[1.6] text-muted">{step.text}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>
