---
import { render } from 'astro:content'
import Article from '../components/Article.astro'
import Demo from '../components/Demo.astro'
import QA from '../components/QA.astro'
import Steps from '../components/Steps.astro'
import TryCard from '../components/TryCard.astro'
import { FEATURES } from '../data/features'
import { type Lang, localePath, t } from '../i18n'
import Base from '../layouts/Base.astro'
import { type Feature, featurePath, getFeatures } from '../lib/pages'

/**
 * One feature: what it solves, how it works in steps, the longer sections from Markdown, what it
 * means for privacy, questions, and the other features of its group.
 */
interface Props {
  lang: Lang
  entry: Feature
  slug: keyof typeof FEATURES
}
const { lang, entry, slug } = Astro.props
const d = t(lang)
const u = d.featurePage
const f = entry.data
const info = FEATURES[slug]
const { Content } = await render(entry)
const all = await getFeatures(lang)
const related = [
  ...all.filter((x) => x.slug !== slug && FEATURES[x.slug].group === info.group),
  ...all.filter((x) => x.slug !== slug && FEATURES[x.slug].group !== info.group),
].slice(0, 5)
const site = Astro.site ?? new URL('https://fixnote.space')
const url = new URL(featurePath(lang, slug), site).href
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: f.faq.map((x) => ({
      '@type': 'Question',
      name: x.q,
      acceptedAnswer: { '@type': 'Answer', text: x.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'FixNote',
        item: new URL(localePath(lang, '/'), site).href,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: d.nav.features,
        item: new URL(localePath(lang, '/features/'), site).href,
      },
      { '@type': 'ListItem', position: 3, name: f.card.title, item: url },
    ],
  },
]
---

<Base
  lang={lang}
  title={f.metaTitle}
  description={f.description}
  path={`/features/${slug}/`}
  crumb={d.nav.features}
  jsonLd={jsonLd}
>
  <Article lang={lang} eyebrow={f.eyebrow} title={f.title} intro={f.intro}>
    <p slot="meta" class="typo-caption mt-4 text-muted">
      {u.plan}: {d.featuresIndex.plan[info.plan]}
    </p>
    <div class="mt-12 mb-4">
      <Demo lang={lang} name={info.media} alt={f.card.title} sizes="(min-width: 735px) 692px, 90vw" eager />
    </div>
    <section class="mt-14">
      <h2 class="typo-subhead text-ink">{u.problem}</h2>
      <p class="typo-body mt-4 text-ink">{f.problem}</p>
    </section>
    <section class="mt-14">
      <h2 class="typo-subhead text-ink">{f.stepsTitle}</h2>
      <Steps items={f.steps} class="mt-6" />
    </section>
    <div class="prose-note prose-page mt-14 text-ink">
      <Content />
    </div>
    <section class="mt-14 rounded-[18px] bg-panel p-7 small:p-10">
      <h2 class="typo-card-headline text-ink">{u.privacy}</h2>
      <p class="typo-body mt-3 text-ink">
        {f.privacy}{' '}
        <a class="link" href={localePath(lang, '/privacy/')}>{u.privacyLink}</a>.
      </p>
    </section>
    <section class="mt-14">
      <h2 class="typo-subhead text-ink">{u.faq}</h2>
      <QA items={f.faq} />
    </section>
    <TryCard lang={lang} />
    <nav class="mt-16 border-t border-line pt-8" aria-label={u.related}>
      <p class="typo-caption font-semibold text-muted">{u.related}</p>
      <ul class="mt-4 space-y-2.5">
        {
          related.map((x) => (
            <li>
              <a class="link typo-body" href={featurePath(lang, x.slug)}>
                {x.entry.data.card.title}
              </a>
            </li>
          ))
        }
        <li>
          <a class="link typo-body" href={localePath(lang, '/features/')}>{u.all}</a>
        </li>
      </ul>
    </nav>
  </Article>
</Base>
