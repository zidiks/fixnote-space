---
import { type Lang, localePath, t } from '../i18n'
import Base from '../layouts/Base.astro'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const d = t(lang)
---

<Base lang={lang} title={d.meta.notFound.title} description={d.meta.notFound.description} path="/404/" alternates={{}} noindex>
  <section class="flex min-h-[60vh] flex-col items-center justify-center bg-white px-6 py-24 text-center">
    <p class="typo-caption font-semibold text-muted">404</p>
    <h1 class="typo-headline mt-2">{d.notFound.title}</h1>
    <p class="typo-intro mt-4 text-muted">{d.notFound.text}</p>
    <a href={localePath(lang, '/')} class="btn btn-primary btn-lg mt-8">{d.notFound.home}</a>
  </section>
</Base>
