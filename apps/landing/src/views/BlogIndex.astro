---
import PostCard from '../components/PostCard.astro'
import SectionHeader from '../components/SectionHeader.astro'
import { type Lang, t } from '../i18n'
import Base from '../layouts/Base.astro'
import { getPosts } from '../lib/blog'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const d = t(lang)
const p = d.blogPage
const posts = await getPosts(lang)
---

<Base lang={lang} title={d.meta.blog.title} description={d.meta.blog.description} path="/blog/">
  <section class="px-4 pb-6 pt-36 sm:px-6 sm:pt-44">
    <SectionHeader as="h1" eyebrow={p.eyebrow} parts={p.headline} lead={p.lead} />
  </section>
  <section class="px-4 py-12 sm:px-6">
    {
      posts.length === 0 ? (
        <p class="text-center text-muted">{p.empty}</p>
      ) : (
        <div class="mx-auto grid max-w-[1100px] gap-4 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post, i) => (
            <PostCard post={post} lang={lang} delay={(i % 3) * 80} />
          ))}
        </div>
      )
    }
  </section>
</Base>
