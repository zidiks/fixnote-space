---
import Article from '../components/Article.astro'
import More from '../components/More.astro'
import { type Lang, t } from '../i18n'
import Base from '../layouts/Base.astro'
import { formatDate, getPosts, postPath, readingMinutes } from '../lib/blog'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const d = t(lang)
const p = d.blogPage
const posts = await getPosts(lang)
---

<Base lang={lang} title={d.meta.blog.title} description={d.meta.blog.description} path="/blog/" crumb={d.nav.blog}>
  <Article lang={lang} eyebrow={p.eyebrow} title={p.headline} intro={p.lead} cta={false}>
    {
      posts.length === 0 ? (
        <p class="typo-body mt-12 text-muted">{p.empty}</p>
      ) : (
        <ul class="mt-12 border-t border-line">
          {posts.map((post) => (
            <li class="border-b border-line py-8">
              <p class="typo-caption text-muted">
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time> ·{' '}
                {readingMinutes(post)} {p.minutes}
              </p>
              <h2 class="typo-card-headline mt-2 text-ink">
                <a href={postPath(post)} class="hover:underline">
                  {post.data.title}
                </a>
              </h2>
              <p class="typo-body mt-2 text-muted">{post.data.description}</p>
              <More href={postPath(post)} class="typo-cta mt-3 inline-block">
                {p.read}
              </More>
            </li>
          ))}
        </ul>
      )
    }
  </Article>
</Base>
