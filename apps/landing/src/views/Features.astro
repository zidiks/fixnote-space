---
import Article from '../components/Article.astro'
import Demo from '../components/Demo.astro'
import TryCard from '../components/TryCard.astro'
import { type Lang, t } from '../i18n'
import Base from '../layouts/Base.astro'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const d = t(lang)
const p = d.featuresPage
---

<Base lang={lang} title={d.meta.features.title} description={d.meta.features.description} path="/features/" crumb={d.nav.features}>
  <Article lang={lang} eyebrow={p.eyebrow} title={p.headline} intro={p.lead}>
    <div class="mt-12 mb-4">
      <Demo lang={lang} name="home" alt={d.hero.shotAlt} sizes="(min-width: 735px) 692px, 90vw" eager />
    </div>
    {
      p.sections.map((s) => (
        <section id={s.id} class="mt-14 scroll-mt-20">
          <h2 class="typo-subhead text-ink">{s.title}</h2>
          <p class="typo-body mt-4 text-ink">{s.text}</p>
          <ol class="mt-6 space-y-4">
            {s.points.map((point, i) => (
              <li class="flex gap-4">
                <span class="typo-caption flex h-7 w-7 flex-none items-center justify-center rounded-full bg-panel font-semibold text-ink tabular-nums">
                  {i + 1}
                </span>
                <p class="typo-body pt-0.5 text-ink">{point}</p>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
    <TryCard lang={lang} />
  </Article>
</Base>
