---
import { render } from 'astro:content'
import ArrowLeft from '@lucide/astro/icons/arrow-left'
import CardRow from '../components/CardRow.astro'
import PostCard from '../components/PostCard.astro'
import { LANG_NAMES, LANGS, localePath, t } from '../i18n'
import Base from '../layouts/Base.astro'
import {
  formatDate,
  getPosts,
  type Post,
  postInfo,
  readingMinutes,
  translations,
} from '../lib/blog'
import FinalCta from './home/FinalCta.astro'

interface Props {
  post: Post
}
const { post } = Astro.props
const { lang, slug } = postInfo(post)
const d = t(lang)
const p = d.blogPage
const { Content } = await render(post)
const alternates = await translations(post)
const more = (await getPosts(lang)).filter((p) => p.id !== post.id).slice(0, 8)
const others = LANGS.filter((l) => l !== lang && alternates[l])
const site = Astro.site ?? new URL('https://fixnote.space')
const url = new URL(localePath(lang, `/blog/${slug}/`), site).href
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString(),
    dateModified: (post.data.updated ?? post.data.date).toISOString(),
    inLanguage: lang,
    mainEntityOfPage: url,
    image: new URL(`/og/${lang}.png`, site).href,
    author: { '@type': 'Organization', name: 'FixNote', url: site.href },
    publisher: {
      '@type': 'Organization',
      name: 'FixNote',
      logo: new URL('/favicon.svg', site).href,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'FixNote',
        item: new URL(localePath(lang, '/'), site).href,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: d.nav.blog,
        item: new URL(localePath(lang, '/blog/'), site).href,
      },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
    ],
  },
]
---

<Base
  lang={lang}
  title={`${post.data.title} · FixNote`}
  description={post.data.description}
  path={`/blog/${slug}/`}
  alternates={alternates}
  type="article"
  jsonLd={jsonLd}
>
  <article class="px-3 pb-10 pt-6 sm:px-6 sm:pt-10">
    <div class="tile mx-auto max-w-[860px] px-5 py-10 sm:px-14 sm:py-16">
      <a href={localePath(lang, '/blog/')} class="more-link text-[15px]">
        <ArrowLeft size={16} /> {p.back}
      </a>
      <h1 class="headline hero-in mt-8 text-[36px] sm:text-[48px]">{post.data.title}</h1>
      <p class="hero-in lead mt-5 text-lg sm:text-xl" style="--delay:80ms">{post.data.description}</p>
      <div class="hero-in mt-6 flex flex-wrap items-center gap-2 text-sm text-muted" style="--delay:120ms">
        <span>{p.published}</span>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingMinutes(post)} {p.minutes}</span>
      </div>
      <div class="prose-note mt-10 border-t border-line pt-10">
        <Content />
      </div>
      {
        others.length > 0 && (
          <p class="mt-14 text-[15px] text-muted">
            {p.otherLanguages}:{' '}
            {others.map((l, i) => (
              <>
                {i > 0 && ' · '}
                <a href={alternates[l]} hreflang={l} lang={l} class="font-medium text-brand-deep hover:underline">
                  {LANG_NAMES[l]}
                </a>
              </>
            ))}
          </p>
        )
      }
    </div>
  </article>
  {
    more.length > 0 && (
      <section class="py-12 sm:py-16">
        <h2 class="headline px-4 text-center text-[28px] sm:text-[40px]">{p.more}</h2>
        <div class="mt-8">
          <CardRow prev={d.reasons.prev} next={d.reasons.next}>
            {more.map((other) => (
              <PostCard post={other} lang={lang} row />
            ))}
          </CardRow>
        </div>
      </section>
    )
  }
  <FinalCta lang={lang} />
</Base>
