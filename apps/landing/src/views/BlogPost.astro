---
import { render } from 'astro:content'
import Chevron from '../components/Chevron.astro'
import TryCard from '../components/TryCard.astro'
import { LANG_NAMES, LANGS, localePath, t } from '../i18n'
import Base from '../layouts/Base.astro'
import {
  formatDate,
  getPosts,
  type Post,
  postInfo,
  postPath,
  readingMinutes,
  translations,
} from '../lib/blog'

interface Props {
  post: Post
}
const { post } = Astro.props
const { lang, slug } = postInfo(post)
const d = t(lang)
const p = d.blogPage
const { Content } = await render(post)
const alternates = await translations(post)
const more = (await getPosts(lang)).filter((p) => p.id !== post.id).slice(0, 4)
const others = LANGS.filter((l) => l !== lang && alternates[l])
const site = Astro.site ?? new URL('https://fixnote.space')
const url = new URL(localePath(lang, `/blog/${slug}/`), site).href
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString(),
    dateModified: (post.data.updated ?? post.data.date).toISOString(),
    inLanguage: lang,
    mainEntityOfPage: url,
    image: new URL(`/og/${lang}.png`, site).href,
    author: { '@type': 'Organization', name: 'FixNote', url: site.href },
    publisher: {
      '@type': 'Organization',
      name: 'FixNote',
      logo: new URL('/favicon.svg', site).href,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'FixNote',
        item: new URL(localePath(lang, '/'), site).href,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: d.nav.blog,
        item: new URL(localePath(lang, '/blog/'), site).href,
      },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
    ],
  },
]
---

<Base
  lang={lang}
  title={`${post.data.title} · FixNote`}
  description={post.data.description}
  path={`/blog/${slug}/`}
  alternates={alternates}
  type="article"
  jsonLd={jsonLd}
  crumb={d.nav.blog}
>
  <div class="bg-white">
    <article class="mx-auto w-[87.5%] max-w-[692px] pt-16 pb-24 small:w-full small:pt-20">
      <p class="typo-caption font-semibold text-muted">
        <a href={localePath(lang, '/blog/')} class="hover:underline">{p.eyebrow}</a>
      </p>
      <h1 class="typo-headline mt-2 text-ink">{post.data.title}</h1>
      <p class="typo-intro mt-6 text-ink">{post.data.description}</p>
      <p class="typo-caption mt-4 text-muted">
        {p.published} <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time> ·{' '}
        {readingMinutes(post)} {p.minutes}
      </p>
      <div class="prose-note mt-14">
        <Content />
      </div>
      {
        others.length > 0 && (
          <p class="typo-caption mt-12 text-muted">
            {p.otherLanguages}:{' '}
            {others.map((l, i) => (
              <>
                {i > 0 && ' · '}
                <a href={alternates[l]} hreflang={l} lang={l} class="link">
                  {LANG_NAMES[l]}
                </a>
              </>
            ))}
          </p>
        )
      }
      <TryCard lang={lang} />
      {
        more.length > 0 && (
          <section class="mt-16">
            <h2 class="typo-subhead text-ink">{p.more}</h2>
            <ul class="mt-6 border-t border-line">
              {more.map((other) => (
                <li class="border-b border-line">
                  <a href={postPath(other)} class="group flex items-center justify-between gap-6 py-5">
                    <span class="typo-body text-ink group-hover:underline">{other.data.title}</span>
                    <Chevron class="h-3 w-2 shrink-0 text-muted" />
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </article>
  </div>
</Base>
