---
import { render } from 'astro:content'
import Chevron from '../components/Chevron.astro'
import QA from '../components/QA.astro'
import TryCard from '../components/TryCard.astro'
import { authorOf } from '../data/authors'
import { LANG_NAMES, LANGS, localePath, t } from '../i18n'
import Base from '../layouts/Base.astro'
import {
  formatDate,
  getPosts,
  type Post,
  postInfo,
  postPath,
  readingMinutes,
  translations,
} from '../lib/blog'
import {
  APP_ID,
  authorPath,
  breadcrumbs,
  faqPage,
  ORG_ID,
  ogImagePath,
  person,
} from '../lib/schema'

interface Props {
  post: Post
}
const { post } = Astro.props
const { lang, slug } = postInfo(post)
const d = t(lang)
const p = d.blogPage
const { Content } = await render(post)
const alternates = await translations(post)
const more = (await getPosts(lang)).filter((p) => p.id !== post.id).slice(0, 4)
const others = LANGS.filter((l) => l !== lang && alternates[l])
const site = Astro.site ?? new URL('https://fixnote.space')
const url = new URL(localePath(lang, `/blog/${slug}/`), site).href
const by = authorOf(post.data.author)
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${url}#article`,
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString(),
    dateModified: (post.data.updated ?? post.data.date).toISOString(),
    inLanguage: lang,
    mainEntityOfPage: { '@id': `${url}#webpage` },
    image: new URL(ogImagePath(lang, `/blog/${slug}/`), site).href,
    author: by ? person(lang, by.id, by.author) : { '@id': ORG_ID },
    publisher: { '@id': ORG_ID },
    about: { '@id': APP_ID },
  },
  breadcrumbs([
    { name: 'FixNote', url: new URL(localePath(lang, '/'), site).href },
    { name: d.nav.blog, url: new URL(localePath(lang, '/blog/'), site).href },
    { name: post.data.title, url },
  ]),
  ...(post.data.faq.length ? [faqPage(post.data.faq)] : []),
]
const title = post.data.title.includes('FixNote') ? post.data.title : `${post.data.title} · FixNote`
---

<Base
  lang={lang}
  title={title}
  description={post.data.description}
  path={`/blog/${slug}/`}
  alternates={alternates}
  type="article"
  jsonLd={jsonLd}
  crumb={d.nav.blog}
  og={{ eyebrow: d.nav.blog }}
>
  <div class="bg-white">
    <article class="mx-auto w-[87.5%] max-w-[692px] pt-16 pb-24 small:w-full small:pt-20">
      <p class="typo-caption font-semibold text-muted">
        <a href={localePath(lang, '/blog/')} class="hover:underline">{p.eyebrow}</a>
      </p>
      <h1 class="typo-headline mt-2 text-ink">{post.data.title}</h1>
      <p class="typo-intro mt-6 text-ink">{post.data.description}</p>
      <p class="typo-caption mt-4 text-muted">
        {
          by &&
            (by.author.bio ? (
              <>
                <a href={authorPath(lang, by.id)} rel="author" class="link">
                  {by.author.name[lang]}
                </a>
                , {by.author.role[lang]} ·{' '}
              </>
            ) : (
              <>
                {by.author.name[lang]}, {by.author.role[lang]} ·{' '}
              </>
            ))
        }
        {p.published} <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
        {
          post.data.updated && (
            <>
              {' '}
              · {p.updated} <time datetime={post.data.updated.toISOString()}>{formatDate(post.data.updated, lang)}</time>
            </>
          )
        }{' '}
        · {readingMinutes(post)} {p.minutes}
      </p>
      <div class="prose-note mt-14">
        <Content />
      </div>
      {
        post.data.faq.length > 0 && (
          <section class="mt-14">
            <h2 class="typo-subhead text-ink">{d.featurePage.faq}</h2>
            <QA items={post.data.faq} />
          </section>
        )
      }
      {
        others.length > 0 && (
          <p class="typo-caption mt-12 text-muted">
            {p.otherLanguages}:{' '}
            {others.map((l, i) => (
              <>
                {i > 0 && ' · '}
                <a href={alternates[l]} hreflang={l} lang={l} class="link">
                  {LANG_NAMES[l]}
                </a>
              </>
            ))}
          </p>
        )
      }
      <TryCard lang={lang} />
      {
        more.length > 0 && (
          <section class="mt-16">
            <h2 class="typo-subhead text-ink">{p.more}</h2>
            <ul class="mt-6 border-t border-line">
              {more.map((other) => (
                <li class="border-b border-line">
                  <a href={postPath(other)} class="group flex items-center justify-between gap-6 py-5">
                    <span class="typo-body text-ink group-hover:underline">{other.data.title}</span>
                    <Chevron class="h-3 w-2 shrink-0 text-muted" />
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </article>
  </div>
</Base>
