---
import Article from '../components/Article.astro'
import DownloadCards from '../components/DownloadCards.astro'
import { type Lang, t } from '../i18n'
import Base from '../layouts/Base.astro'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const d = t(lang)
const p = d.downloadPage
const notes = [
  {
    title: d.download.macNoteTitle,
    text: d.download.macNote,
    code: 'xattr -cr /Applications/FixNote.app',
  },
  { title: d.download.windowsNoteTitle, text: d.download.windowsNote, code: undefined },
]
---

<Base lang={lang} title={d.meta.download.title} description={d.meta.download.description} path="/download/" crumb={d.nav.download}>
  <Article lang={lang} eyebrow={p.eyebrow} title={p.headline} intro={p.lead} cta={false}>
    <DownloadCards lang={lang} />
    {
      notes.map((note) => (
        <section class="mt-14">
          <h2 class="typo-subhead text-ink">{note.title}</h2>
          <p class="typo-body mt-4 text-ink">{note.text}</p>
          {note.code && (
            <pre class="mt-4 overflow-x-auto rounded-xl bg-panel px-5 py-4 font-mono text-[15px] text-ink"><code>{note.code}</code></pre>
          )}
        </section>
      ))
    }
    <section class="mt-14 rounded-[18px] bg-panel p-7 small:p-10">
      <h2 class="typo-card-headline text-ink">{p.requirementsTitle}</h2>
      <ul class="typo-body mt-4 list-disc space-y-2 pl-5 text-ink">
        {p.requirements.map((r) => <li>{r}</li>)}
      </ul>
    </section>
  </Article>
</Base>
