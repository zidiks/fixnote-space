---
import { type Lang, t } from '../i18n'
import Base from '../layouts/Base.astro'
import { app, faqPage, ogImagePath } from '../lib/schema'
import Blog from './home/Blog.astro'
import Compare from './home/Compare.astro'
import Faq from './home/Faq.astro'
import Features from './home/Features.astro'
import Overview from './home/Overview.astro'
import Pricing from './home/Pricing.astro'
import Reasons from './home/Reasons.astro'
import Tools from './home/Tools.astro'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const d = t(lang)
const site = Astro.site ?? new URL('https://fixnote.space')
const image = new URL(ogImagePath(lang, '/'), site).href
const jsonLd = [app(lang, d.meta.home.description, image), faqPage(d.faq.items)]
---

<Base
  lang={lang}
  title={d.meta.home.title}
  description={d.meta.home.description}
  path="/"
  jsonLd={jsonLd}
  notes={d.notes}
  og={{ eyebrow: d.hero.eyebrow, title: d.hero.subtitle, shot: `${lang}/home` }}
>
  <Overview lang={lang} />
  <Features lang={lang} />
  <Reasons lang={lang} />
  <Tools lang={lang} />
  <Blog lang={lang} />
  <Compare lang={lang} />
  <Pricing lang={lang} />
  <Faq lang={lang} />
</Base>
