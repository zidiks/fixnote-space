---
import { type Lang, t } from '../i18n'
import Base from '../layouts/Base.astro'
import { app, faqPage, ogImagePath } from '../lib/schema'
import '../styles/home.css'
import HomeFooter from '../components/HomeFooter.astro'
import Closing from './home/Closing.astro'
import Faq from './home/Faq.astro'
import Integrations from './home/Integrations.astro'
import Intro from './home/Intro.astro'
import Plans from './home/Plans.astro'
import Privacy from './home/Privacy.astro'
import Recall from './home/Recall.astro'
import Tidy from './home/Tidy.astro'
import Voice from './home/Voice.astro'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const d = t(lang)
const site = Astro.site ?? new URL('https://fixnote.space')
const image = new URL(ogImagePath(lang, '/'), site).href
const jsonLd = [app(lang, d.meta.home.description, image), faqPage(d.landing.faq.items)]
---

<Base
  lang={lang}
  title={d.meta.home.title}
  description={d.meta.home.description}
  path="/"
  jsonLd={jsonLd}
  notes={d.notes}
  overlay
  og={{ eyebrow: d.hero.eyebrow, title: d.hero.subtitle, shot: `${lang}/home` }}
>
  <Intro lang={lang} />
  <Tidy lang={lang} />
  <Integrations lang={lang} />
  <Recall lang={lang} />
  <Privacy lang={lang} />
  <Voice lang={lang} />
  <Plans lang={lang} />
  <Faq lang={lang} />
  <Closing lang={lang} />
  <HomeFooter slot="footer" lang={lang} />
</Base>
