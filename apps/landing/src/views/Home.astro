---
import { type Lang, t } from '../i18n'
import Base from '../layouts/Base.astro'
import Blog from './home/Blog.astro'
import Compare from './home/Compare.astro'
import Faq from './home/Faq.astro'
import Features from './home/Features.astro'
import Overview from './home/Overview.astro'
import Pricing from './home/Pricing.astro'
import Reasons from './home/Reasons.astro'
import Tools from './home/Tools.astro'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const d = t(lang)
const site = Astro.site ?? new URL('https://fixnote.space')
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'FixNote',
    description: d.meta.home.description,
    applicationCategory: 'ProductivityApplication',
    operatingSystem: 'Windows, macOS, Web',
    url: site.href,
    inLanguage: lang,
    offers: [
      { '@type': 'Offer', name: 'Free', price: '0', priceCurrency: 'USD' },
      { '@type': 'Offer', name: 'Pro', price: '7', priceCurrency: 'USD' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faq.items.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
]
---

<Base lang={lang} title={d.meta.home.title} description={d.meta.home.description} path="/" jsonLd={jsonLd} notes={d.notes}>
  <Overview lang={lang} />
  <Features lang={lang} />
  <Reasons lang={lang} />
  <Tools lang={lang} />
  <Blog lang={lang} />
  <Compare lang={lang} />
  <Pricing lang={lang} />
  <Faq lang={lang} />
</Base>
