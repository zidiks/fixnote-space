---
import { type Lang, t } from '../i18n'
import Base from '../layouts/Base.astro'
import BlogTeaser from './home/BlogTeaser.astro'
import FaqSection from './home/FaqSection.astro'
import Hero from './home/Hero.astro'
import Pricing from './home/Pricing.astro'
import Questions from './home/Questions.astro'
import Reasons from './home/Reasons.astro'
import SecurityTeaser from './home/SecurityTeaser.astro'
import Showcase from './home/Showcase.astro'
import Steps from './home/Steps.astro'
import Tiles from './home/Tiles.astro'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const d = t(lang)
const site = Astro.site ?? new URL('https://fixnote.space')
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'FixNote',
    description: d.meta.home.description,
    applicationCategory: 'ProductivityApplication',
    operatingSystem: 'Windows, macOS, Web',
    url: site.href,
    inLanguage: lang,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faq.items.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
]
---

<Base lang={lang} title={d.meta.home.title} description={d.meta.home.description} path="/" jsonLd={jsonLd} notes={d.notes}>
  <Hero lang={lang} />
  <Tiles lang={lang} />
  <Showcase lang={lang} />
  <Questions lang={lang} />
  <Reasons lang={lang} />
  <SecurityTeaser lang={lang} />
  <div class="h-20 sm:h-28"></div>
  <Pricing lang={lang} />
  <Steps lang={lang} />
  <FaqSection lang={lang} />
  <BlogTeaser lang={lang} />
</Base>
