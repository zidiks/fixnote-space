# Built files carry a content hash, so they never change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# App videos keep their names when re-recorded, so they are cached for a week.
/video/*
  Cache-Control: public, max-age=604800

# MCP Registry domain proof for space.fixnote/* (apps/relay/server.json). The private key is
# kept off the repository; the registry fetches this as text/plain, without redirects.
/.well-known/mcp-registry-auth
  Content-Type: text/plain; charset=utf-8

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
