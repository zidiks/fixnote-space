{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "landing",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@fixnote/landing", "dev"],
      "port": 4321
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@fixnote/web", "dev"],
      "port": 5173
    },
    {
      "name": "landing-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@fixnote/landing", "preview", "--port", "4322"],
      "port": 4322
    },
    {
      "name": "extension-dist",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@fixnote/extension",
        "exec",
        "vite",
        "dist",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180
    },
    {
      "name": "brand",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4330", "--directory", "brand"],
      "port": 4330
    }
  ]
}
